6d:["$","p",null,{"children":[["$","strong",null,{"children":"Market Positioning Strategy"}],": Different model families create different competitive advantages. Linear models get you to market fast with regulatory approval, while neural networks unlock new product capabilities that competitors can't easily replicate."]}]
6e:["$","p",null,{"children":[["$","strong",null,{"children":"Resource Allocation"}],": Tree-based models give you the best ROI on business data problems, while neural networks require significant engineering investment but unlock new market opportunities."]}]
6f:["$","p",null,{"children":[["$","strong",null,{"children":"Time-to-Market Considerations"}],": Linear models can ship in weeks, tree models in months, neural networks often require quarters of development. Match your model choice to your business timeline."]}]
70:["$","p",null,{"children":[["$","strong",null,{"children":"Regulatory and Compliance Requirements"}],": Financial services and healthcare heavily favor interpretable models. If you're in a regulated industry, linear and tree models will get you through compliance faster."]}]
71:["$","p",null,{"children":[["$","strong",null,{"children":"Data Strategy Implications"}],": Unsupervised learning works with any data you have, supervised learning requires labeled examples, and neural networks need significant data volumes. Your data availability should drive your model selection."]}]
72:["$","p",null,{"children":[["$","strong",null,{"children":"Competitive Moat Development"}],": Neural networks create technical capabilities that are harder for competitors to replicate, while linear models create speed-to-market advantages that competitors can't catch up to."]}]
73:["$","h3",null,{"className":"flex scroll-m-28 flex-row items-center gap-2","id":"strategic-decision-framework","children":[["$","a",null,{"data-card":"","href":"#strategic-decision-framework","className":"peer","children":"Strategic Decision Framework"}],["$","svg",null,{"ref":"$undefined","xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide size-3.5 shrink-0 text-fd-muted-foreground opacity-0 transition-opacity peer-hover:opacity-100","aria-label":"Link to section","children":[[["$","path","1cjeqo",{"d":"M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"}],["$","path","19qd67",{"d":"M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"}]],"$undefined"]}]]}]
74:["$","p",null,{"children":[["$","strong",null,{"children":"For New Product Launches"}],": Start with linear models for speed, then evolve to tree-based models for performance, and finally to neural networks for differentiation."]}]
75:["$","p",null,{"children":[["$","strong",null,{"children":"For Market Expansion"}],": Use unsupervised learning to discover new customer segments, then apply supervised learning to optimize for those segments."]}]
76:["$","p",null,{"children":[["$","strong",null,{"children":"For Competitive Advantage"}],": Invest in neural networks for capabilities your competitors can't easily replicate, while maintaining linear models for operational efficiency."]}]
77:["$","p",null,{"children":[["$","strong",null,{"children":"For Regulatory Compliance"}],": Prioritize interpretable models (linear and tree-based) to ensure auditability and regulatory approval."]}]
78:["$","p",null,{"children":"The goal isn't to become a machine learning expert—it's to make strategic decisions that position your product and company for maximum market impact. Choose the right tool for your market position, timeline, and competitive strategy."}]
