69:["$","ul",null,{"children":["\n",["$","li",null,{"children":"Static knowledge — can’t adapt to new facts without retraining."}],"\n",["$","li",null,{"children":"Risk of overfitting if fine-tuning data is narrow."}],"\n",["$","li",null,{"children":["Doesn’t inherently reduce hallucination — just ",["$","em",null,{"children":"shifts"}]," it to your fine-tuning domain."]}],"\n"]}]
