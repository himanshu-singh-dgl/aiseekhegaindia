65:["$","ul",null,{"children":["\n",["$","li",null,{"children":["🧠 ",["$","strong",null,{"children":"Retains base knowledge:"}]," No catastrophic forgetting."]}],"\n",["$","li",null,{"children":["💾 ",["$","strong",null,{"children":"Lightweight:"}]," Only a few million parameters to train instead of billions."]}],"\n",["$","li",null,{"children":["🕒 ",["$","strong",null,{"children":"Fast:"}]," Fine-tune large models on a single GPU."]}],"\n",["$","li",null,{"children":["🧰 ",["$","strong",null,{"children":"Tooling support:"}]," Hugging Face PEFT makes it almost plug-and-play."]}],"\n"]}]
