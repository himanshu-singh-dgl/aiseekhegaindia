3f:["$","ol",null,{"children":["\n",["$","li",null,{"children":["Transformer Architecture:","\n",["$","ul",null,{"children":["\n",["$","li",null,{"children":"GPT-2 is a transformer neural network, a framework still used in state-of-the-art AI models today."}],"\n",["$","li",null,{"children":"The architecture enables self-attention mechanisms, allowing the model to capture long-range dependencies in text."}],"\n"]}],"\n"]}],"\n",["$","li",null,{"children":["Parameter Scale:","\n",["$","ul",null,{"children":["\n",["$","li",null,{"children":"GPT-2 had 1.6 billion parameters, which was substantial at the time but small compared to today’s models, which have hundreds of billions or even trillions of parameters."}],"\n"]}],"\n"]}],"\n",["$","li",null,{"children":["Context Length:","\n",["$","ul",null,{"children":["\n",["$","li",null,{"children":"The maximum context length of GPT-2 was 1,024 tokens."}],"\n",["$","li",null,{"children":"Modern transformers have significantly extended this limit, with some reaching hundreds of thousands to a million tokens, enhancing their ability to understand and generate coherent text over long passages."}],"\n"]}],"\n"]}],"\n",["$","li",null,{"children":["Training Data:","\n",["$","ul",null,{"children":["\n",["$","li",null,{"children":"GPT-2 was trained on approximately 100 billion tokens."}],"\n",["$","li",null,{"children":"By comparison, modern datasets, such as the FineWeb dataset, contain 15 trillion tokens, highlighting the exponential growth in training data availability."}],"\n"]}],"\n"]}],"\n"]}]
40:["$","h5",null,{"className":"flex scroll-m-28 flex-row items-center gap-2","id":"training-gpt-2-a-step-by-step-look","children":[["$","a",null,{"data-card":"","href":"#training-gpt-2-a-step-by-step-look","className":"peer","children":["$","strong",null,{"children":"Training GPT-2: A Step-by-Step Look"}]}],["$","svg",null,{"ref":"$undefined","xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide size-3.5 shrink-0 text-fd-muted-foreground opacity-0 transition-opacity peer-hover:opacity-100","aria-label":"Link to section","children":[[["$","path","1cjeqo",{"d":"M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"}],["$","path","19qd67",{"d":"M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"}]],"$undefined"]}]]}]
41:["$","p",null,{"children":"Training a model like GPT-2 involves iteratively adjusting its parameters to improve its ability to predict the next token in a given text sequence. Let’s break down the training process:"}]
42:["$","ol",null,{"children":["\n",["$","li",null,{"children":["Data Processing & Tokenization:","\n",["$","ul",null,{"children":["\n",["$","li",null,{"children":"Large text datasets are gathered, cleaned, and tokenized."}],"\n",["$","li",null,{"children":"Tokenization converts words or subwords into numerical representations that the model can process."}],"\n"]}],"\n"]}],"\n",["$","li",null,{"children":["Forward Pass (Prediction Phase):","\n",["$","ul",null,{"children":["\n",["$","li",null,{"children":"The model takes in a sequence of tokens and predicts the next token based on learned probabilities."}],"\n"]}],"\n"]}],"\n",["$","li",null,{"children":["Loss Calculation:","\n",["$","ul",null,{"children":["\n",["$","li",null,{"children":"A numerical loss value is computed, indicating how incorrect the model’s predictions are."}],"\n",["$","li",null,{"children":"A lower loss means better predictions."}],"\n"]}],"\n"]}],"\n",["$","li",null,{"children":["Backward Pass (Optimization Phase):","\n",["$","ul",null,{"children":["\n",["$","li",null,{"children":"The model updates its parameters using optimization algorithms like Adam, adjusting them to minimize the loss."}],"\n",["$","li",null,{"children":"Each update refines the model’s ability to predict the next token accurately."}],"\n"]}],"\n"]}],"\n",["$","li",null,{"children":["Iteration Over Steps:","\n",["$","ul",null,{"children":["\n",["$","li",null,{"children":"Training consists of thousands to millions of iterations, with each step refining the model’s predictions."}],"\n",["$","li",null,{"children":"A well-trained model will eventually generate fluent and coherent text sequences."}],"\n"]}],"\n"]}],"\n"]}]
