41:["$","ul",null,{"children":["\n",["$","li",null,{"children":["\n",["$","h5",null,{"className":"flex scroll-m-28 flex-row items-center gap-2","id":"the-concept","children":[["$","a",null,{"data-card":"","href":"#the-concept","className":"peer","children":"The Concept:"}],["$","svg",null,{"ref":"$undefined","xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide size-3.5 shrink-0 text-fd-muted-foreground opacity-0 transition-opacity peer-hover:opacity-100","aria-label":"Link to section","children":[[["$","path","1cjeqo",{"d":"M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"}],["$","path","19qd67",{"d":"M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"}]],"$undefined"]}]]}],"\n",["$","ul",null,{"children":["\n",["$","li",null,{"children":"RLHF aims to train LLMs in unverifiable domains by using human feedback as a reward signal."}],"\n",["$","li",null,{"children":"The key idea is to train a \"reward model\" that mimics human preferences."}],"\n"]}],"\n"]}],"\n",["$","li",null,{"children":["\n",["$","h5",null,{"className":"flex scroll-m-28 flex-row items-center gap-2","id":"the-process","children":[["$","a",null,{"data-card":"","href":"#the-process","className":"peer","children":"The Process:"}],["$","svg",null,{"ref":"$undefined","xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide size-3.5 shrink-0 text-fd-muted-foreground opacity-0 transition-opacity peer-hover:opacity-100","aria-label":"Link to section","children":[[["$","path","1cjeqo",{"d":"M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"}],["$","path","19qd67",{"d":"M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"}]],"$undefined"]}]]}],"\n",["$","ul",null,{"children":["\n",["$","li",null,{"children":"Human annotation: Humans rank or order multiple LLM-generated outputs (e.g., jokes) based on their quality."}],"\n",["$","li",null,{"children":"Reward model training: A separate neural network (the reward model) is trained to predict human rankings."}],"\n",["$","li",null,{"children":"RL optimization: The LLM is trained to generate outputs that maximize the reward model's score."}],"\n"]}],"\n"]}],"\n",["$","li",null,{"children":["\n",["$","h5",null,{"className":"flex scroll-m-28 flex-row items-center gap-2","id":"the-advantage","children":[["$","a",null,{"data-card":"","href":"#the-advantage","className":"peer","children":"The Advantage:"}],["$","svg",null,{"ref":"$undefined","xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide size-3.5 shrink-0 text-fd-muted-foreground opacity-0 transition-opacity peer-hover:opacity-100","aria-label":"Link to section","children":[[["$","path","1cjeqo",{"d":"M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"}],["$","path","19qd67",{"d":"M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"}]],"$undefined"]}]]}],"\n",["$","ul",null,{"children":["\n",["$","li",null,{"children":"RLHF allows us to train LLMs in unverifiable domains without requiring humans to generate ideal outputs."}],"\n",["$","li",null,{"children":"Humans are only asked to rank or order existing outputs, which is a simpler task."}],"\n"]}],"\n"]}],"\n"]}]
