41:["$","p",null,{"children":["A neural network consists of a large set of parameters (also called weights) that define how input data is transformed into outputs. These parameters are initially set randomly, leading the model to make arbitrary predictions. However, through a process called training, the parameters are iteratively adjusted to align with meaningful patterns in data.",["$","br",null,{}],"\n","Think of parameters as knobs on a DJ set—adjusting them changes the way the model processes and interprets inputs."]}]
42:["$","h5",null,{"className":"flex scroll-m-28 flex-row items-center gap-2","id":"mathematical-operations-in-neural-networks","children":[["$","a",null,{"data-card":"","href":"#mathematical-operations-in-neural-networks","className":"peer","children":["$","strong",null,{"children":"Mathematical Operations in Neural Networks"}]}],["$","svg",null,{"ref":"$undefined","xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide size-3.5 shrink-0 text-fd-muted-foreground opacity-0 transition-opacity peer-hover:opacity-100","aria-label":"Link to section","children":[[["$","path","1cjeqo",{"d":"M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"}],["$","path","19qd67",{"d":"M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"}]],"$undefined"]}]]}]
43:["$","p",null,{"children":"At its core, a neural network is a mathematical function that transforms inputs into outputs using a series of operations, such as:"}]
44:["$","ul",null,{"children":["\n",["$","li",null,{"children":"Multiplication (scaling inputs with weights)"}],"\n",["$","li",null,{"children":"Addition (combining weighted inputs)"}],"\n",["$","li",null,{"children":"Exponentiation (e.g., in activation functions)"}],"\n",["$","li",null,{"children":"Normalization (adjusting values for stability)"}],"\n",["$","li",null,{"children":"Softmax (converting outputs into probabilities)"}],"\n"]}]
45:["$","p",null,{"children":"The architecture of the neural network dictates how these operations are arranged, ensuring efficiency, expressiveness, and optimizability."}]
46:["$","h5",null,{"className":"flex scroll-m-28 flex-row items-center gap-2","id":"4-the-transformer-architecture","children":[["$","a",null,{"data-card":"","href":"#4-the-transformer-architecture","className":"peer","children":["$","strong",null,{"children":"4. The Transformer Architecture"}]}],["$","svg",null,{"ref":"$undefined","xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide size-3.5 shrink-0 text-fd-muted-foreground opacity-0 transition-opacity peer-hover:opacity-100","aria-label":"Link to section","children":[[["$","path","1cjeqo",{"d":"M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"}],["$","path","19qd67",{"d":"M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"}]],"$undefined"]}]]}]
47:["$","p",null,{"children":["One of the most advanced and widely used neural network architectures is the Transformer, which excels at handling sequential data, such as text.",["$","br",null,{}],"\n","Structure of a Transformer"]}]
48:["$","p",null,{"children":"A. Transformer consists of several key components:"}]
49:["$","ul",null,{"children":["\n",["$","li",null,{"children":"Token Embeddings: Convert input tokens into numerical vectors."}],"\n",["$","li",null,{"children":"Self-Attention Mechanism: Determines how different tokens relate to each other."}],"\n",["$","li",null,{"children":"Layer Normalization: Ensures stable training by normalizing activations."}],"\n",["$","li",null,{"children":"Feedforward Layers (MLP Block): Applies transformations to refine token representations."}],"\n",["$","li",null,{"children":"Output Layer (Softmax): Predicts the next token in a sequence based on learned patterns."}],"\n"]}]
4a:["$","p",null,{"children":"B.Information Flow in a Transformer"}]
4b:["$","ul",null,{"children":["\n",["$","li",null,{"children":"Input tokens are first embedded into numerical vectors."}],"\n",["$","li",null,{"children":"These embeddings are passed through self-attention layers, allowing the model to focus on relevant parts of the input"}],"\n",["$","li",null,{"children":"The output of self-attention is processed through feedforward layers, refining the representation."}],"\n",["$","li",null,{"children":"The final layer produces logits, which are converted into probabilities to determine the next token prediction."}],"\n"]}]
4c:["$","h5",null,{"className":"flex scroll-m-28 flex-row items-center gap-2","id":"training-a-neural-network","children":[["$","a",null,{"data-card":"","href":"#training-a-neural-network","className":"peer","children":["$","strong",null,{"children":"Training a Neural Network"}]}],["$","svg",null,{"ref":"$undefined","xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide size-3.5 shrink-0 text-fd-muted-foreground opacity-0 transition-opacity peer-hover:opacity-100","aria-label":"Link to section","children":[[["$","path","1cjeqo",{"d":"M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"}],["$","path","19qd67",{"d":"M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"}]],"$undefined"]}]]}]
4d:["$","p",null,{"children":"Training a neural network involves finding the best parameter values to minimize prediction errors. The key steps include:"}]
4e:["$","ol",null,{"children":["\n",["$","li",null,{"children":"Forward Pass: Compute predictions based on current parameter values."}],"\n",["$","li",null,{"children":"Loss Calculation: Compare predictions with actual outputs to measure error."}],"\n",["$","li",null,{"children":"Backward Pass (Gradient Descent): Adjust parameters using optimization techniques like Stochastic Gradient Descent (SGD) or Adam to reduce error."}],"\n",["$","li",null,{"children":"Iteration: Repeat these steps over millions of examples until the model generalizes well to unseen data."}],"\n"]}]
4f:["$","h5",null,{"className":"flex scroll-m-28 flex-row items-center gap-2","id":"inference-generating-new-data","children":[["$","a",null,{"data-card":"","href":"#inference-generating-new-data","className":"peer","children":["$","strong",null,{"children":"Inference: Generating New Data"}]}],["$","svg",null,{"ref":"$undefined","xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide size-3.5 shrink-0 text-fd-muted-foreground opacity-0 transition-opacity peer-hover:opacity-100","aria-label":"Link to section","children":[[["$","path","1cjeqo",{"d":"M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"}],["$","path","19qd67",{"d":"M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"}]],"$undefined"]}]]}]
50:["$","p",null,{"children":["Once a neural network is trained, it can be used for inference, meaning it generates new data based on learned patterns.",["$","br",null,{}],"\n","How Inference Works:"]}]
51:["$","ol",null,{"children":["\n",["$","li",null,{"children":["Input Processing:",["$","br",null,{}],"\n","A sequence of tokens is provided to the trained model."]}],"\n",["$","li",null,{"children":["Prediction:",["$","br",null,{}],"\n","The model computes probabilities for the next token."]}],"\n",["$","li",null,{"children":["Sampling:",["$","br",null,{}],"\n","The next token is selected based on probabilities (e.g., greedy decoding, beam search, or temperature-controlled sampling)."]}],"\n",["$","li",null,{"children":["Iteration:",["$","br",null,{}],"\n","Steps 1-3 are repeated until the desired sequence length is reached."]}],"\n"]}]
52:["$","p",null,{"children":"For example, given the input \"Once upon a time,\" the model might predict the next word as \"there\" and continue generating a coherent story."}]
53:["$","div",null,{"className":"flex flex-row flex-wrap items-center justify-between gap-4 empty:hidden","children":["$undefined","$undefined"]}]
