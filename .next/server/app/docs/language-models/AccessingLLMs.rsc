43:["$","ul",null,{"children":["\n",["$","li",null,{"children":["\n",["$","h3",null,{"className":"flex scroll-m-28 flex-row items-center gap-2","id":"the-process","children":[["$","a",null,{"data-card":"","href":"#the-process","className":"peer","children":"The Process:"}],["$","svg",null,{"ref":"$undefined","xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide size-3.5 shrink-0 text-fd-muted-foreground opacity-0 transition-opacity peer-hover:opacity-100","aria-label":"Link to section","children":[[["$","path","1cjeqo",{"d":"M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"}],["$","path","19qd67",{"d":"M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"}]],"$undefined"]}]]}],"\n",["$","ul",null,{"children":["\n",["$","li",null,{"children":"When you enter a query into a platform like ChatGPT, your text is first tokenized."}],"\n",["$","li",null,{"children":"The tokens are then fed into the LLM, which generates a response based on its trained parameters."}],"\n",["$","li",null,{"children":"The response is then decoded from tokens back into human-readable text."}],"\n"]}],"\n"]}],"\n",["$","li",null,{"children":["\n",["$","h3",null,{"className":"flex scroll-m-28 flex-row items-center gap-2","id":"behind-the-scenes","children":[["$","a",null,{"data-card":"","href":"#behind-the-scenes","className":"peer","children":"Behind the Scenes:"}],["$","svg",null,{"ref":"$undefined","xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide size-3.5 shrink-0 text-fd-muted-foreground opacity-0 transition-opacity peer-hover:opacity-100","aria-label":"Link to section","children":[[["$","path","1cjeqo",{"d":"M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"}],["$","path","19qd67",{"d":"M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"}]],"$undefined"]}]]}],"\n",["$","ul",null,{"children":["\n",["$","li",null,{"children":"LLMs are complex neural networks that process vast amounts of data."}],"\n",["$","li",null,{"children":"They use techniques like attention mechanisms to understand the relationships between words and generate coherent responses."}],"\n",["$","li",null,{"children":"The model is fixed, and the only thing that changes is the context window."}],"\n"]}],"\n"]}],"\n",["$","li",null,{"children":["\n",["$","h3",null,{"className":"flex scroll-m-28 flex-row items-center gap-2","id":"context-windows","children":[["$","a",null,{"data-card":"","href":"#context-windows","className":"peer","children":"Context Windows:"}],["$","svg",null,{"ref":"$undefined","xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide size-3.5 shrink-0 text-fd-muted-foreground opacity-0 transition-opacity peer-hover:opacity-100","aria-label":"Link to section","children":[[["$","path","1cjeqo",{"d":"M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"}],["$","path","19qd67",{"d":"M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"}]],"$undefined"]}]]}],"\n",["$","ul",null,{"children":["\n",["$","li",null,{"children":"The context window is the memory of the model. It uses the context window to understand the conversation."}],"\n"]}],"\n"]}],"\n"]}]
