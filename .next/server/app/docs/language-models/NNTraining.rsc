3f:["$","p",null,{"children":["Before training, raw text data is transformed into a sequence of tokens using a tokenizer. These tokens are unique numerical IDs that represent small chunks of text.",["$","br",null,{}],"\n","For example, consider a dataset with 15 trillion tokens. Each token is a discrete unit that the neural network will learn to process and predict.",["$","br",null,{}],"\n","Key points:"]}]
40:["$","ul",null,{"children":["\n",["$","li",null,{"children":"The dataset is represented as a long sequence of tokens."}],"\n",["$","li",null,{"children":"Each token is assigned a unique numerical ID."}],"\n",["$","li",null,{"children":"The numbers themselves do not have inherent meaning but serve as identifiers."}],"\n"]}]
41:["$","h5",null,{"className":"flex scroll-m-28 flex-row items-center gap-2","id":"3-neural-network-training-process","children":[["$","a",null,{"data-card":"","href":"#3-neural-network-training-process","className":"peer","children":["$","strong",null,{"children":"3. Neural Network Training Process"}]}],["$","svg",null,{"ref":"$undefined","xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide size-3.5 shrink-0 text-fd-muted-foreground opacity-0 transition-opacity peer-hover:opacity-100","aria-label":"Link to section","children":[[["$","path","1cjeqo",{"d":"M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"}],["$","path","19qd67",{"d":"M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"}]],"$undefined"]}]]}]
42:["$","p",null,{"children":"Neural network training involves modeling the statistical relationships between tokens in a sequence."}]
43:["$","p",null,{"children":["3.1. Windowing and Context Creation",["$","br",null,{}],"\n","To learn these relationships, we divide the dataset into smaller parts known as token windows. A window consists of a fixed number of consecutive tokens taken from the dataset."]}]
44:["$","ul",null,{"children":["\n",["$","li",null,{"children":"The window size can vary (e.g., 4,000, 8,000, or 16,000 tokens), but is usually limited due to computational constraints."}],"\n",["$","li",null,{"children":"For simplicity, let's consider a window size of 4 tokens."}],"\n",["$","li",null,{"children":"These 4 tokens serve as the context for predicting the next token."}],"\n"]}]
45:["$","p",null,{"children":["3.2. Predicting the Next Token",["$","br",null,{}],"\n","Given a sequence of tokens, the neural network aims to predict the next token in the sequence.",["$","br",null,{}],"\n","For example, consider the following sequence of token IDs:"]}]
46:["$","ul",null,{"children":["\n",["$","li",null,{"children":"Input (context): 3962, 2847, 1209, 531"}],"\n",["$","li",null,{"children":"Expected next token: 8743"}],"\n"]}]
47:["$","p",null,{"children":"The neural network's job is to assign probabilities to all possible next tokens from the vocabulary (e.g., 100,277 possible tokens). Initially, these probabilities are random."}]
48:["$","h5",null,{"className":"flex scroll-m-28 flex-row items-center gap-2","id":"4-updating-the-neural-network","children":[["$","a",null,{"data-card":"","href":"#4-updating-the-neural-network","className":"peer","children":["$","strong",null,{"children":"4. Updating the Neural Network"}]}],["$","svg",null,{"ref":"$undefined","xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide size-3.5 shrink-0 text-fd-muted-foreground opacity-0 transition-opacity peer-hover:opacity-100","aria-label":"Link to section","children":[[["$","path","1cjeqo",{"d":"M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"}],["$","path","19qd67",{"d":"M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"}]],"$undefined"]}]]}]
49:["$","p",null,{"children":"The model improves by adjusting its predictions based on the correct token. This process follows these steps:"}]
4a:["$","ol",null,{"children":["\n",["$","li",null,{"children":"Compute Initial Probabilities: The model assigns probabilities to all possible next tokens."}],"\n",["$","li",null,{"children":"Compare with Ground Truth: The actual next token is known from the dataset."}],"\n",["$","li",null,{"children":"Adjust Model Weights: The model updates itself to increase the probability of the correct token while decreasing the probabilities of incorrect tokens."}],"\n",["$","li",null,{"children":"Iterate Over Large Batches: This process is repeated across large batches of token sequences to refine the model."}],"\n"]}]
4b:["$","p",null,{"children":".For example:"}]
4c:["$","ul",null,{"children":["\n",["$","li",null,{"children":["\n",["$","p",null,{"children":"Initial prediction:"}],"\n",["$","ul",null,{"children":["\n",["$","li",null,{"children":"Token A: 4%"}],"\n",["$","li",null,{"children":"Token B: 2%"}],"\n",["$","li",null,{"children":"Token C (Correct Answer): 3%"}],"\n"]}],"\n"]}],"\n",["$","li",null,{"children":["\n",["$","p",null,{"children":"After training update:"}],"\n",["$","ul",null,{"children":["\n",["$","li",null,{"children":["\n",["$","p",null,{"children":"Token A: 2%"}],"\n"]}],"\n",["$","li",null,{"children":["\n",["$","p",null,{"children":"Token B: 1%"}],"\n"]}],"\n",["$","li",null,{"children":["\n",["$","h5",null,{"className":"flex scroll-m-28 flex-row items-center gap-2","id":"token-c-4-more-likely-to-be-predicted-next-time","children":[["$","a",null,{"data-card":"","href":"#token-c-4-more-likely-to-be-predicted-next-time","className":"peer","children":"Token C: 4% (more likely to be predicted next time)"}],["$","svg",null,{"ref":"$undefined","xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide size-3.5 shrink-0 text-fd-muted-foreground opacity-0 transition-opacity peer-hover:opacity-100","aria-label":"Link to section","children":[[["$","path","1cjeqo",{"d":"M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"}],["$","path","19qd67",{"d":"M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"}]],"$undefined"]}]]}],"\n"]}],"\n"]}],"\n"]}],"\n"]}]
