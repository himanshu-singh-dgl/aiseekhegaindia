4a:I[3878,["619","static/chunks/619-ba102abea3e3d0e4.js","672","static/chunks/672-0ae560e623ccbb53.js","793","static/chunks/793-47ac01fa05ca9791.js","661","static/chunks/661-b05643b2074f060a.js","561","static/chunks/561-557ca4485a838793.js","870","static/chunks/app/docs/%5B%5B...slug%5D%5D/page-5c050de4a94866fc.js"],"I18nLabel"]
3d:["$","ul",null,{"children":["\n",["$","li",null,{"children":["Training Data Influence: LLMs learn by statistically imitating patterns in their training data.","\n",["$","ul",null,{"children":["\n",["$","li",null,{"children":"If the training data contains many confident answers to questions like \"Who is...?\", the model will learn to provide confident answers, even when it doesn't know the correct information."}],"\n"]}],"\n"]}],"\n",["$","li",null,{"children":"Lack of Real-World Understanding: LLMs don't have direct access to the internet or a true understanding of the world. They manipulate tokens based on statistical probabilities, not real-world knowledge."}],"\n",["$","li",null,{"children":"The \"Confident Tone\" Issue: During training, responses are often written by humans that convey confidence in their answers, even if the information has been quickly researched, and this also leads to the model conveying a similar style, even when incorrect."}],"\n"]}]
3e:["$","p",null,{"children":"3. Mitigating Hallucinations: Step 1 - Explicitly Teaching \"I Don't Know\""}]
3f:["$","ul",null,{"children":["\n",["$","li",null,{"children":"The Principle: The aim is to enable the LLM to recognize its knowledge boundaries and respond appropriately when it lacks information."}],"\n",["$","li",null,{"children":["The Process:","\n",["$","ul",null,{"children":["\n",["$","li",null,{"children":"Knowledge Probing: Systematically test the LLM's knowledge by asking factual questions derived from its training data."}],"\n",["$","li",null,{"children":"Automated Verification: Use other LLMs or programmatic methods to compare the model's answers with known correct answers."}],"\n",["$","li",null,{"children":"Data Augmentation: Add training examples where the correct answer to a question is \"I don't know\" or \"I'm sorry, I don't have that information.\""}],"\n"]}],"\n"]}],"\n",["$","li",null,{"children":"The Result: By learning to associate uncertainty with specific responses, the LLM becomes more likely to admit when it doesn't know something."}],"\n"]}]
40:["$","p",null,{"children":"4. Mitigating Hallucinations: Step 2 - Enabling Tool Use (Web Search)"}]
41:["$","ul",null,{"children":["\n",["$","li",null,{"children":["The Concept:",["$","br",null,{}],"\n","Give LLMs the ability to access and process external information, such as web search results, to enhance their knowledge."]}],"\n",["$","li",null,{"children":["How it Works:","\n",["$","ul",null,{"children":["\n",["$","li",null,{"children":"Introduce special tokens (e.g., \"search_start,\" \"search_end\") that trigger external actions."}],"\n",["$","li",null,{"children":"When the LLM encounters these tokens, the system pauses generation, performs a web search based on the query, and inserts the retrieved text into the context window."}],"\n",["$","li",null,{"children":"The model can then use the information within the context window to answer the question."}],"\n"]}],"\n"]}],"\n",["$","li",null,{"children":["The Benefits:","\n",["$","ul",null,{"children":["\n",["$","li",null,{"children":"Access to up-to-date information."}],"\n",["$","li",null,{"children":"Improved accuracy and factual consistency."}],"\n",["$","li",null,{"children":"Ability to cite sources and provide verifiable information."}],"\n"]}],"\n"]}],"\n",["$","li",null,{"children":"Context Windows and Working Memory: Explaining that context windows serve as the \"working memory\" for an LLM is a useful tool. This helps the student understand the difference between long term training memory, and the current, active information being used by the LLM."}],"\n"]}]
42:["$","p",null,{"children":"5. The Knowledge of Self: Understanding LLM Limitations"}]
43:["$","ul",null,{"children":["\n",["$","li",null,{"children":["Model Identification:",["$","br",null,{}],"\n","It is common to ask LLMs questions such as \"what model are you?\"."]}],"\n",["$","li",null,{"children":["The Reality:",["$","br",null,{}],"\n","The data that an LLM has about itself, is the training data that it was given. Therefore, its responses regarding \"itself\" are still based off of training data."]}],"\n",["$","li",null,{"children":["Practical Implications:","\n",["$","ul",null,{"children":["\n",["$","li",null,{"children":"Emphasize the importance of providing relevant information within the context window for accurate responses."}],"\n",["$","li",null,{"children":"Recognize the limitations of LLM self-awareness."}],"\n"]}],"\n"]}],"\n"]}]
