4b:["$","p",null,{"children":"We've explored LLM computation and the importance of token distribution. Now, let's examine a specific area where LLMs often struggle: character-level tasks. Understanding why LLMs have difficulties with these tasks is crucial for effective LLM usage."}]
4c:["$","h5",null,{"className":"flex scroll-m-28 flex-row items-center gap-2","id":"1-the-token-centric-world-of-llms","children":[["$","a",null,{"data-card":"","href":"#1-the-token-centric-world-of-llms","className":"peer","children":["$","strong",null,{"children":"1. The Token-Centric World of LLMs"}]}],["$","svg",null,{"ref":"$undefined","xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide size-3.5 shrink-0 text-fd-muted-foreground opacity-0 transition-opacity peer-hover:opacity-100","aria-label":"Link to section","children":[[["$","path","1cjeqo",{"d":"M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"}],["$","path","19qd67",{"d":"M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"}]],"$undefined"]}]]}]
4d:["$","ul",null,{"children":["\n",["$","li",null,{"children":["Tokens, Not Characters:",["$","br",null,{}],"\n","LLMs don't \"see\" individual characters like humans do. Their world is built on tokens, which are chunks of text."]}],"\n",["$","li",null,{"children":["Tokenization:","\n",["$","ul",null,{"children":["\n",["$","li",null,{"children":"Words and characters are broken down into tokens, which can vary in size."}],"\n",["$","li",null,{"children":"This process can lead to situations where individual letters are grouped within a single token."}],"\n",["$","li",null,{"children":"For example, the word \"ubiquitous\" might be broken into three tokens, making it difficult for the LLM to access individual letters."}],"\n"]}],"\n"]}],"\n",["$","li",null,{"children":["Efficiency vs. Character-Level Access:","\n",["$","ul",null,{"children":["\n",["$","li",null,{"children":"Tokens are used primarily for efficiency, as they reduce the length of sequences that LLMs need to process."}],"\n",["$","li",null,{"children":"However, this comes at the cost of character-level access, making tasks like manipulating individual letters challenging."}],"\n"]}],"\n"]}],"\n",["$","li",null,{"children":["Visual Analogy:",["$","br",null,{}],"\n","Imagine trying to read a sentence where the letters are grouped into random chunks. It would be difficult to isolate and manipulate individual letters."]}],"\n"]}]
4e:["$","h5",null,{"className":"flex scroll-m-28 flex-row items-center gap-2","id":"2-llm-challenges-with-character-level-tasks","children":[["$","a",null,{"data-card":"","href":"#2-llm-challenges-with-character-level-tasks","className":"peer","children":["$","strong",null,{"children":"2. LLM Challenges with Character-Level Tasks"}]}],["$","svg",null,{"ref":"$undefined","xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide size-3.5 shrink-0 text-fd-muted-foreground opacity-0 transition-opacity peer-hover:opacity-100","aria-label":"Link to section","children":[[["$","path","1cjeqo",{"d":"M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"}],["$","path","19qd67",{"d":"M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"}]],"$undefined"]}]]}]
4f:["$","ul",null,{"children":["\n",["$","li",null,{"children":["Spelling Tasks:","\n",["$","ul",null,{"children":["\n",["$","li",null,{"children":"LLMs struggle with tasks that require manipulating individual characters, such as extracting every third letter from a word."}],"\n",["$","li",null,{"children":"Example: Extracting every third letter from \"ubiquitous.\""}],"\n",["$","li",null,{"children":"The LLM might fail because it sees the word as a sequence of tokens, not individual letters."}],"\n"]}],"\n"]}],"\n",["$","li",null,{"children":["Counting Characters:","\n",["$","ul",null,{"children":["\n",["$","li",null,{"children":"LLMs are not inherently good at counting, and this is compounded when they need to count individual characters within tokens."}],"\n",["$","li",null,{"children":"Example: Counting the number of \"r\"s in \"strawberry.\""}],"\n",["$","li",null,{"children":"The LLM might initially give an incorrect answer because it struggles to access and count individual \"r\"s within the tokens."}],"\n"]}],"\n"]}],"\n",["$","li",null,{"children":"Mental Arithmetic Revisited: Similar to computation, character manipulation can be thought of as a kind of mental arithmetic, which the LLM struggles with."}],"\n"]}]
50:["$","h5",null,{"className":"flex scroll-m-28 flex-row items-center gap-2","id":"3-the-power-of-tool-usage-for-character-level-tasks","children":[["$","a",null,{"data-card":"","href":"#3-the-power-of-tool-usage-for-character-level-tasks","className":"peer","children":["$","strong",null,{"children":"3. The Power of Tool Usage for Character-Level Tasks"}]}],["$","svg",null,{"ref":"$undefined","xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide size-3.5 shrink-0 text-fd-muted-foreground opacity-0 transition-opacity peer-hover:opacity-100","aria-label":"Link to section","children":[[["$","path","1cjeqo",{"d":"M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"}],["$","path","19qd67",{"d":"M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"}]],"$undefined"]}]]}]
51:["$","ul",null,{"children":["\n",["$","li",null,{"children":["Code Interpreter to the Rescue:","\n",["$","ul",null,{"children":["\n",["$","li",null,{"children":"Using a code interpreter (e.g., Python) allows LLMs to delegate character-level tasks to a more suitable tool."}],"\n",["$","li",null,{"children":"Example: Using Python to extract every third letter from \"ubiquitous\" or count the \"r\"s in \"strawberry.\""}],"\n",["$","li",null,{"children":"The LLM can copy the input string into the code interpreter, which can then manipulate the characters directly."}],"\n"]}],"\n"]}],"\n",["$","li",null,{"children":["Offloading the Burden:","\n",["$","ul",null,{"children":["\n",["$","li",null,{"children":"This approach offloads the character-level manipulation from the LLM's neural network to the code interpreter."}],"\n",["$","li",null,{"children":"The LLM can then use the output from the code interpreter to provide the correct answer."}],"\n"]}],"\n"]}],"\n",["$","li",null,{"children":["Copy/Paste Ability:",["$","br",null,{}],"\n","LLMs are very strong at copying and pasting information. This is how they can reliably send information to the code interpreter."]}],"\n"]}]
