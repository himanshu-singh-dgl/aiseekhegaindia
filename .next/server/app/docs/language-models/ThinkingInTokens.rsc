43:["$","ul",null,{"children":["\n",["$","li",null,{"children":["Intermediate Results:",["$","br",null,{}],"\n","Encourage LLMs to generate intermediate results, breaking down complex tasks into simpler ones."]}],"\n",["$","li",null,{"children":["Step-by-Step Reasoning:",["$","br",null,{}],"\n","Guide LLMs to perform step-by-step reasoning, allowing them to build upon previous calculations."]}],"\n",["$","li",null,{"children":["Working Memory:",["$","br",null,{}],"\n","The context window acts as the LLM's working memory, storing intermediate results for later use."]}],"\n"]}]
44:["$","h5",null,{"className":"flex scroll-m-28 flex-row items-center gap-2","id":"4-leveraging-tools-for-computation","children":[["$","a",null,{"data-card":"","href":"#4-leveraging-tools-for-computation","className":"peer","children":["$","strong",null,{"children":"4. Leveraging Tools for Computation"}]}],["$","svg",null,{"ref":"$undefined","xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide size-3.5 shrink-0 text-fd-muted-foreground opacity-0 transition-opacity peer-hover:opacity-100","aria-label":"Link to section","children":[[["$","path","1cjeqo",{"d":"M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"}],["$","path","19qd67",{"d":"M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"}]],"$undefined"]}]]}]
45:["$","ul",null,{"children":["\n",["$","li",null,{"children":["Code Interpreter:","\n",["$","ul",null,{"children":["\n",["$","li",null,{"children":"LLMs can use code interpreters (e.g., Python) to perform complex calculations."}],"\n",["$","li",null,{"children":"This offloads the computational burden from the LLM's neural network to a dedicated tool."}],"\n",["$","li",null,{"children":"This is far more reliable than the LLM trying to do mental math."}],"\n"]}],"\n"]}],"\n",["$","li",null,{"children":["Counting Example:","\n",["$","ul",null,{"children":["\n",["$","li",null,{"children":"LLMs struggle with counting because it requires processing a large amount of information within a single token."}],"\n",["$","li",null,{"children":"Using a code interpreter allows the LLM to delegate the counting task to a more efficient tool."}],"\n"]}],"\n"]}],"\n",["$","li",null,{"children":["General Tool Use:","\n",["$","ul",null,{"children":["\n",["$","li",null,{"children":"LLMs can utilize various tools to enhance their capabilities, including web search, code execution, and data retrieval."}],"\n",["$","li",null,{"children":"Tool use is crucial for tasks that require external knowledge or complex computations."}],"\n"]}],"\n"]}],"\n",["$","li",null,{"children":"Why code is trusted: Code, when executed, has a fixed set of rules, and a deterministic output. This is far more reliable than the probabalistic output of an LLM."}],"\n"]}]
46:["$","h5",null,{"className":"flex scroll-m-28 flex-row items-center gap-2","id":"5-cognitive-deficits-and-sharp-edges","children":[["$","a",null,{"data-card":"","href":"#5-cognitive-deficits-and-sharp-edges","className":"peer","children":["$","strong",null,{"children":"5. Cognitive Deficits and Sharp Edges"}]}],["$","svg",null,{"ref":"$undefined","xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide size-3.5 shrink-0 text-fd-muted-foreground opacity-0 transition-opacity peer-hover:opacity-100","aria-label":"Link to section","children":[[["$","path","1cjeqo",{"d":"M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"}],["$","path","19qd67",{"d":"M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"}]],"$undefined"]}]]}]
47:["$","ul",null,{"children":["\n",["$","li",null,{"children":"Spelling Tasks: LLMs can struggle with certain spelling-related tasks due to the way they process and generate tokens."}],"\n",["$","li",null,{"children":"Counting: As we have seen, counting is another area where LLMs are weak."}],"\n",["$","li",null,{"children":"Understanding Tokenization: The way words and characters are broken down into tokens can affect how LLMs process information."}],"\n",["$","li",null,{"children":"The Importance of Awareness: Recognizing these limitations is crucial for effectively using LLMs."}],"\n"]}]
