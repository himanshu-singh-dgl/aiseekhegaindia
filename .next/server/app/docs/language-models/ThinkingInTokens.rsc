3f:["$","ul",null,{"children":["\n",["$","li",null,{"children":["Sequential Processing:",["$","br",null,{}],"\n","LLMs process information and generate text token by token, from left to right."]}],"\n",["$","li",null,{"children":["Neural Network Computation:",["$","br",null,{}],"\n","For each token, the LLM's neural network performs a series of computations to determine the probability of the next token."]}],"\n",["$","li",null,{"children":["Finite Computation per Token:","\n",["$","ul",null,{"children":["\n",["$","li",null,{"children":"The amount of computation performed for each token is limited."}],"\n",["$","li",null,{"children":"This means LLMs cannot perform complex calculations within a single token."}],"\n",["$","li",null,{"children":"Think of it as each token having a small, fixed \"thinking budget.\""}],"\n"]}],"\n"]}],"\n",["$","li",null,{"children":["Analogy:",["$","br",null,{}],"\n","Imagine trying to solve a complex math problem in a single step versus breaking it down into smaller, manageable steps. LLMs operate similarly."]}],"\n"]}]
