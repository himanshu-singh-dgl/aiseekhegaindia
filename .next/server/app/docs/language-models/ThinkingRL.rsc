3f:["$","ul",null,{"children":["\n",["$","li",null,{"children":["\n",["$","p",null,{"children":"The Significance:"}],"\n",["$","ul",null,{"children":["\n",["$","li",null,{"children":"The DeepSeek R1 paper from DeepSeek Kai in China publicly detailed the power of RL in LLM training."}],"\n",["$","li",null,{"children":"It demonstrated how RL can significantly enhance LLM reasoning capabilities, particularly in complex problem-solving."}],"\n"]}],"\n"]}],"\n",["$","li",null,{"children":["\n",["$","h6",null,{"className":"flex scroll-m-28 flex-row items-center gap-2","id":"the-math-problem-example-revisited","children":[["$","a",null,{"data-card":"","href":"#the-math-problem-example-revisited","className":"peer","children":"The Math Problem Example Revisited:"}],["$","svg",null,{"ref":"$undefined","xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide size-3.5 shrink-0 text-fd-muted-foreground opacity-0 transition-opacity peer-hover:opacity-100","aria-label":"Link to section","children":[[["$","path","1cjeqo",{"d":"M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"}],["$","path","19qd67",{"d":"M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"}]],"$undefined"]}]]}],"\n",["$","ul",null,{"children":["\n",["$","li",null,{"children":"The paper showed a significant improvement in LLM accuracy on math problems after RL fine-tuning."}],"\n",["$","li",null,{"children":"This isn't just about getting the right answer; it's about how the LLM arrives at the answer."}],"\n"]}],"\n"]}],"\n",["$","li",null,{"children":["\n",["$","h6",null,{"className":"flex scroll-m-28 flex-row items-center gap-2","id":"emergent-thinking","children":[["$","a",null,{"data-card":"","href":"#emergent-thinking","className":"peer","children":"Emergent Thinking:"}],["$","svg",null,{"ref":"$undefined","xmlns":"http://www.w3.org/2000/svg","wi