7 7.07l1.71-1.71"}]],"$undefined"]}]]}],"\n",["$","ul",null,{"children":["\n",["$","li",null,{"children":"DeepSeek R1 is available on chat.deepseek.com and together.ai."}],"\n",["$","li",null,{"children":"OpenAI offers thinking models in its GPT-4 01 and 03 variants (available with a paid subscription)."}],"\n",["$","li",null,{"children":"Google's Gemini 2.0 Flash Thinking is also an experimental thinking model."}],"\n"]}],"\n"]}],"\n",["$","li",null,{"children":["\n",["$","h6",null,{"className":"flex scroll-m-28 flex-row items-center gap-2","id":"the-difference","children":[["$","a",null,{"data-card":"","href":"#the-difference","className":"peer","children":"The Difference:"}],["$","svg",null,{"ref":"$undefined","xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide size-3.5 shrink-0 text-fd-muted-foreground opacity-0 transition-opacity peer-hover:opacity-100","aria-label":"Link to section","children":[[["$","path","1cjeqo",{"d":"M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"}],["$","path","19qd67",{"d":"M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"}]],"$undefined"]}]]}],"\n",["$","ul",null,{"children":["\n",["$","li",null,{"children":"Standard LLMs (like GPT-4) primarily rely on supervised fine-tuning (SFT) and don't exhibit the same level of detailed reasoning."}],"\n",["$","li",null,{"children":"They are great for knowledge retrieval, but not as good at difficult problem solving."}],"\n"]}],"\n"]}],"\n",["$","li",null,{"children":["\n",["$","h6",null,{"className":"flex scroll-m-28 flex-row items-center gap-2","id":"practical-applications","children":[["$","a",null,{"data-card":"","href":"#practical-applications","className":"peer","children":"Practical Applications:"}],["$","svg",null,{"ref":"$undefined","xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24",