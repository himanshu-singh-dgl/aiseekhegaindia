3f:["$","p",null,{"children":["Let’s begin with an intuitive motivation. Imagine a ball moving in 2D space. You're asked to predict its next location.",["$","br",null,{}],"\n",["$","strong",null,{"children":"Case 1:"}],["$","br",null,{}],"\n","You only have access to the ball's current position. Any prediction you make will essentially be a guess — the problem is underdetermined."]}]
40:["$","p",null,{"children":[["$","strong",null,{"children":"Case 2:"}],["$","br",null,{}],"\n","You're also given the ball’s prior trajectory — its historical positions. With this sequence of past states, you can now model its motion and reasonably estimate its future position."]}]
41:["$","p",null,{"children":"This illustrates the crux of sequence modeling: incorporating historical context to improve predictive accuracy."}]
42:["$","h2",null,{"className":"flex scroll-m-28 flex-row items-center gap-2","id":"sequence-data-in-the-real-world","children":[["$","a",null,{"data-card":"","href":"#sequence-data-in-the-real-world","className":"peer","children":"Sequence Data in the Real World"}],["$","svg",null,{"ref":"$undefined","xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide size-3.5 shrink-0 text-fd-muted-foreground opacity-0 transition-opacity peer-hover:opacity-100","aria-label":"Link to section","children":[[["$","path","1cjeqo",{"d":"M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"}],["$","path","19qd67",{"d":"M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"}]],"$undefined"]}]]}]
43:["$","p",null,{"children":"While the example above is simple, the relevance of sequence modeling extends across diverse domains:"}]
44:["$","ul",null,{"children":["\n",["$","li",null,{"children":["\n",["$","p",null,{"children":[["$","strong",null,{"children":"Speech and Audio:"}],["$","br",null,{}],"\n","Voice signals can be decomposed into sequences of sound wave chunks over time."]}],"\n"]}],"\n",["$","li",null,{"children":["\n",["$","p",null,{"children":[["$","strong",null,{"children":"Natural Language:"}],["$","br",null,{}],"\n","Sentences are sequences of words or characters."]}],"\n"]}],"\n",["$","li",null,{"children":["\n",["$","p",null,{"children":[["$","strong",null,{"children":"Medical Signals:"}],["$","br",null,{}],"\n","ECGs and EEGs are temporal sequences of voltage measurements."]}],"\n"]}],"\n",["$","li",null,{"children":["\n",["$","p",null,{"children":[["$","strong",null,{"children":"Finance:"}],["$","br",null,{}],"\n","Stock prices and market indicators evolve as time-series data."]}],"\n"]}],"\n",["$","li",null,{"children":["\n",["$","p",null,{"children":[["$","strong",null,{"children":"Biology:"}],["$","br",null,{}],"\n","DNA and protein sequences are naturally sequential."]}],"\n"]}],"\n",["$","li",null,{"children":["\n",["$","p",null,{"children":[["$","strong",null,{"children":"Video:"}],["$","br",null,{}],"\n","Frame-by-frame temporal evolution can be modeled as sequences."]}],"\n"]}],"\n",["$","li",null,{"children":["\n",["$","p",null,{"children":[["$","strong",null,{"children":"Weather Forecasting:"}],["$","br",null,{}],"\n","Historical weather patterns provide sequential structure for future prediction."]}],"\n"]}],"\n"]}]
45:["$","p",null,{"children":"In each case, the temporal or positional ordering of data points is essential. Ignoring that order risks discarding key patterns."}]
