81:["$","h2",null,{"className":"flex scroll-m-28 flex-row items-center gap-2","id":"the-deep-learning-revolution-in-visual-understanding","children":[["$","a",null,{"data-card":"","href":"#the-deep-learning-revolution-in-visual-understanding","className":"peer","children":"The Deep Learning Revolution in Visual Understanding"}],["$","svg",null,{"ref":"$undefined","xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide size-3.5 shrink-0 text-fd-muted-foreground opacity-0 transition-opacity peer-hover:opacity-100","aria-label":"Link to section","children":[[["$","path","1cjeqo",{"d":"M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"}],["$","path","19qd67",{"d":"M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"}]],"$undefined"]}]]}]
82:["$","p",null,{"children":"In the past decade, deep learning has transformed the landscape of computer vision. What was once a field defined by handcrafted features, pipelines of rule-based heuristics, and brittle performance is now dominated by end-to-end models that learn directly from raw pixels."}]
83:["$","p",null,{"children":"This shift is not just an incremental improvement. It is a foundational rethinking of how machines perceive and interpret visual information. Deep neural networks have become the primary engine for visual perception tasks across industries and platforms, from large-scale robotics systems to compact mobile devices."}]
84:["$","h2",null,{"className":"flex scroll-m-28 flex-row items-center gap-2","id":"real-world-applications-from-cloud-to-edge","children":[["$","a",null,{"data-card":"","href":"#real-world-applications-from-cloud-to-edge","className":"peer","children":"Real-World Applications: From Cloud to Edge"}],["$","svg",null,{"ref":"$undefined","xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide size-3.5 shrink-0 text-fd-muted-foreground opacity-0 transition-opacity peer-hover:opacity-100","aria-label":"Link to section","children":[[["$","path","1cjeqo",{"d":"M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"}],["$","path","19qd67",{"d":"M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"}]],"$undefined"]}]]}]
85:["$","p",null,{"children":"Computer vision is no longer confined to research labs or high-end servers. Today, it runs in your pocket."}]
86:["$","p",null,{"children":"Modern smartphones ship with multiple vision models embedded in their hardware. These models power tasks such as real-time face recognition for authentication, scene segmentation for photo enhancement, and even depth estimation to support augmented reality."}]
87:["$","p",null,{"children":"Embedded vision is also key to autonomous drones, smart glasses, and wearables. These edge devices operate with strict latency and power constraints, yet they perform complex visual inference tasks. The deep learning models they use are highly optimized, often quantized, and sometimes trained using transfer learning from larger models."}]
88:["$","h2",null,{"className":"flex scroll-m-28 flex-row items-center gap-2","id":"vision-in-healthcare-and-biology","children":[["$","a",null,{"data-card":"","href":"#vision-in-healthcare-and-biology","className":"peer","children":"Vision in Healthcare and Biology"}],["$","svg",null,{"ref":"$undefined","xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide size-3.5 shrink-0 text-fd-muted-foreground opacity-0 transition-opacity peer-hover:opacity-100","aria-label":"Link to section","children":[[["$","path","1cjeqo",{"d":"M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"}],["$","path","19qd67",{"d":"M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"}]],"$undefined"]}]]}]
89:["$","p",null,{"children":"In healthcare and biology, deep learning offers capabilities that rival expert-level human performance."}]
8a:["$","p",null,{"children":"Computer vision systems now analyze medical images such as X-rays, MRIs, and pathology slides to detect anomalies, classify tissue types, and even estimate disease progression. Importantly, they can detect subtle features that are often overlooked by human observers, and they do so with consistency and speed."}]
8b:["$","p",null,{"children":"For instance, retinal imaging models assist ophthalmologists in diagnosing diabetic retinopathy. In radiology, convolutional networks help prioritize scans with potential tumors for urgent review. These tools are reshaping diagnostic workflows and expanding access to expert-grade medical analysis."}]
8c:["$","h2",null,{"className":"flex scroll-m-28 flex-row items-center gap-2","id":"self-driving-cars-a-grand-challenge-for-vision","children":[["$","a",null,{"data-card":"","href":"#self-driving-cars-a-grand-challenge-for-vision","className":"peer","children":"Self-Driving Cars: A Grand Challenge for Vision"}],["$","svg",null,{"ref":"$undefined","xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide size-3.5 shrink-0 text-fd-muted-foreground opacity-0 transition-opacity peer-hover:opacity-100","aria-label":"Link to section","children":[[["$","path","1cjeqo",{"d":"M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"}],["$","path","19qd67",{"d":"M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"}]],"$undefined"]}]]}]
8d:["$","p",null,{"children":"Autonomous driving represents one of the most complex and high-stakes applications of computer vision."}]
8e:["$","p",null,{"children":"One of the hallmark projects in this domain was developed at MIT. Unlike the traditional approach of building a pipeline of modular subsystems—one for perception, one for planning, another for control—this project involved building an end-to-end model. The model learned to drive directly from raw visual input without relying on predefined maps."}]
8f:["$","p",null,{"children":"The input to the model was the raw image stream from front-facing cameras. The output was driving commands. This method is elegant but challenging, as it requires the model to implicitly learn navigation, obstacle avoidance, traffic rule compliance, and more, just from visual input."}]
90:["$","p",null,{"children":"What made this project significant was that the system could generalize to unseen roads. It did not need prior knowledge of the environment. This points toward a future where vision-based autonomy might not require detailed HD maps or handcrafted priors."}]
91:["$","h2",null,{"className":"flex scroll-m-28 flex-row items-center gap-2","id":"classical-to-contemporary-facial-recognition-as-a-case-study","children":[["$","a",null,{"data-card":"","href":"#classical-to-contemporary-facial-recognition-as-a-case-study","className":"peer","children":"Classical to Contemporary: Facial Recognition as a Case Study"}],["$","svg",null,{"ref":"$undefined","xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide size-3.5 shrink-0 text-fd-muted-foreground opacity-0 transition-opacity peer-hover:opacity-100","aria-label":"Link to section","children":[[["$","path","1cjeqo",{"d":"M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"}],["$","path","19qd67",{"d":"M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"}]],"$undefined"]}]]}]
92:["$","p",null,{"children":"One of the earliest and most impactful applications of computer vision was facial detection. Initially, the goal was simple: detect whether or not a face is present in an image."}]
93:["$","p",null,{"children":["With deep learning, this problem has evolved dramatically. Modern models not only detect faces but also extract nuanced features such as facial landmarks, gaze direction, and micro-expressions. These features allow systems to estimate emotional state, detect identity under occlusion, and even track attention in real-time.\n",["$","$L19e",null,{"sizes":"(max-width: 768px) 100vw, (max-width: 1200px) 70vw, 900px","src":"./image_cnn_2.png","alt":"This is an ALT text","className":"rounded-lg"}],"\n",["$","$L19e",null,{"sizes":"(max-width: 768px) 100vw, (max-width: 1200px) 70vw, 900px","src":"./image_cnn_3.png","alt":"This is an ALT text","className":"rounded-lg"}],"\n",["$","$L19e",null,{"sizes":"(max-width: 768px) 100vw, (max-width: 1200px) 70vw, 900px","src":"./image_cnn_4.png","alt":"This is an ALT text","className":"rounded-lg"}],"\n",["$","$L19e",null,{"sizes":"(max-width: 768px) 100vw, (max-width: 1200px) 70vw, 900px","src":"./image_cnn_5.png","alt":"This is an ALT text","className":"rounded-lg"}]]}]
94:["$","h1",null,{"className":"flex scroll-m-28 flex-row items-center gap-2","id":"chapter-3-from-pixels-to-perception--how-computers-interpret-images","children":[["$","a",null,{"data-card":"","href":"#chapter-3-from-pixels-to-perception--how-computers-interpret-images","className":"peer","children":"Chapter 3: From Pixels to Perception — How Computers Interpret Images"}],["$","svg",null,{"ref":"$undefined","xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide size-3.5 shrink-0 text-fd-muted-foreground opacity-0 transition-opacity peer-hover:opacity-100","aria-label":"Link to section","children":[[["$","path","1cjeqo",{"d":"M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"}],["$","path","19qd67",{"d":"M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"}]],"$undefined"]}]]}]
95:["$","h2",null,{"className":"flex scroll-m-28 flex-row items-center gap-2","id":"bridging-human-intuition-and-machine-perception","children":[["$","a",null,{"data-card":"","href":"#bridging-human-intuition-and-machine-perception","className":"peer","children":"Bridging Human Intuition and Machine Perception"}],["$","svg",null,{"ref":"$undefined","xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide size-3.5 shrink-0 text-fd-muted-foreground opacity-0 transition-opacity peer-hover:opacity-100","aria-label":"Link to section","children":[[["$","path","1cjeqo",{"d":"M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"}],["$","path","19qd67",{"d":"M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"}]],"$undefined"]}]]}]
96:["$","p",null,{"children":["In today’s class, we begin to transition from high-level applications to the underlying mechanics that enable them. The central question is both philosophical and technical: ",["$","strong",null,{"children":"how can we take a task that humans perform effortlessly and encode that capability into machines?"}]]}]
97:["$","p",null,{"children":"For example, recognizing a face, distinguishing between two objects, or interpreting a scene are actions we perform with no conscious thought. Yet each of these tasks requires a series of complex perceptual computations."}]
98:["$","blockquote",null,{"children":["\n",["$","p",null,{"children":"The goal is to design models that can perform such tasks with the same level of efficiency and accuracy, despite the lack of human intuition."}],"\n"]}]
99:["$","hr",null,{}]
9a:["$","h2",null,{"className":"flex scroll-m-28 flex-row items-center gap-2","id":"how-computers-represent-images","children":[["$","a",null,{"data-card":"","href":"#how-computers-represent-images","className":"peer","children":"How Computers Represent Images"}],["$","svg",null,{"ref":"$undefined","xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide size-3.5 shrink-0 text-fd-muted-foreground opacity-0 transition-opacity peer-hover:opacity-100","aria-label":"Link to section","children":[[["$","path","1cjeqo",{"d":"M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"}],["$","path","19qd67",{"d":"M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"}]],"$undefined"]}]]}]
9b:["$","p",null,{"children":"At the lowest level, images are fundamentally numerical. While to us an image of Abraham Lincoln is a coherent visual entity, to a computer it is nothing more than a structured set of values."}]
9c:["$","ul",null,{"children":["\n",["$","li",null,{"children":["In ",["$","strong",null,{"children":"grayscale images"}],", each pixel is represented by a single intensity value."]}],"\n",["$","li",null,{"children":["In ",["$","strong",null,{"children":"color images"}],", each pixel is represented by a triplet of numbers corresponding to ",["$","strong",null,{"children":"red"}],", ",["$","strong",null,{"children":"green"}],", and ",["$","strong",null,{"children":"blue"}]," intensities."]}],"\n"]}]
9d:["$","p",null,{"children":"This leads to two primary types of image representations:"}]
9e:["$","ul",null,{"children":["\n",["$","li",null,{"children":[["$","strong",null,{"children":"Grayscale Image"}],": Represented as a 2D matrix of shape ",["$","code",null,{"children":"(height, width)"}]]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"Color Image"}],": Represented as a 3D tensor of shape ",["$","code",null,{"children":"(height, width, 3)"}]]}],"\n"]}]
9f:["$","p",null,{"children":["This structured representation is ideal for feeding into neural networks. Unlike text, which must be tokenized and embedded, images are already in a ",["$","strong",null,{"children":"dense numerical format"}],". The challenge is not converting them into numbers, but ",["$","strong",null,{"children":"interpreting"}]," the numbers meaningfully."]}]
a0:["$","hr",null,{}]
a1:["$","h2",null,{"className":"flex scroll-m-28 flex-row items-center gap-2","id":"understanding-the-learning-tasks-regression-and-classification","children":[["$","a",null,{"data-card":"","href":"#understanding-the-learning-tasks-regression-and-classification","className":"peer","children":"Understanding the Learning Tasks: Regression and Classification"}],["$","svg",null,{"ref":"$undefined","xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide size-3.5 shrink-0 text-fd-muted-foreground opacity-0 transition-opacity peer-hover:opacity-100","aria-label":"Link to section","children":[[["$","path","1cjeqo",{"d":"M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"}],["$","path","19qd67",{"d":"M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"}]],"$undefined"]}]]}]
a2:["$","p",null,{"children":"Once an image is represented numerically, we can train deep learning models to perform specific tasks. These tasks typically fall into two broad categories:"}]
a3:["$","h3",null,{"className":"flex scroll-m-28 flex-row items-center gap-2","id":"regression","children":[["$","a",null,{"data-card":"","href":"#regression","className":"peer","children":"Regression"}],["$","svg",null,{"ref":"$undefined","xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide size-3.5 shrink-0 text-fd-muted-foreground opacity-0 transition-opacity peer-hover:opacity-100","aria-label":"Link to section","children":[[["$","path","1cjeqo",{"d":"M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"}],["$","path","19qd67",{"d":"M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"}]],"$undefined"]}]]}]
a4:["$","ul",null,{"children":["\n",["$","li",null,{"children":[["$","strong",null,{"children":"Outputs"}]," continuous values."]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"Examples in vision"}],":","\n",["$","ul",null,{"children":["\n",["$","li",null,{"children":"Predicting the age of a person from a face image"}],"\n",["$","li",null,{"children":"Estimating the depth of each pixel in a scene"}],"\n",["$","li",null,{"children":"Forecasting motion vectors"}],"\n"]}],"\n"]}],"\n"]}]
a5:["$","h3",null,{"className":"flex scroll-m-28 flex-row items-center gap-2","id":"classification","children":[["$","a",null,{"data-card":"","href":"#classification","className":"peer","children":"Classification"}],["$","svg",null,{"ref":"$undefined","xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide size-3.5 shrink-0 text-fd-muted-foreground opacity-0 transition-opacity peer-hover:opacity-100","aria-label":"Link to section","children":[[["$","path","1cjeqo",{"d":"M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"}],["$","path","19qd67",{"d":"M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"}]],"$undefined"]}]]}]
a6:["$","ul",null,{"children":["\n",["$","li",null,{"children":[["$","strong",null,{"children":"Outputs"}]," discrete class labels."]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"Example"}],": Given an image of a historical figure, determine whether it is Abraham Lincoln, George Washington, or another U.S. president."]}],"\n",["$","li",null,{"children":["The output is one of ",["$","strong",null,{"children":"K"}]," possible categories, and the model must learn to assign high probability to the correct one."]}],"\n"]}]
a7:["$","blockquote",null,{"children":["\n",["$","p",null,{"children":"The classification task is central to many computer vision problems. For a model to classify images correctly, it must first learn to identify the features that distinguish one class from another."}],"\n"]}]
a8:["$","hr",null,{}]
a9:["$","h2",null,{"className":"flex scroll-m-28 flex-row items-center gap-2","id":"feature-extraction-the-key-to-recognition","children":[["$","a",null,{"data-card":"","href":"#feature-extraction-the-key-to-recognition","className":"peer","children":"Feature Extraction: The Key to Recognition"}],["$","svg",null,{"ref":"$undefined","xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide size-3.5 shrink-0 text-fd-muted-foreground opacity-0 transition-opacity peer-hover:opacity-100","aria-label":"Link to section","children":[[["$","path","1cjeqo",{"d":"M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"}],["$","path","19qd67",{"d":"M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"}]],"$undefined"]}]]}]
aa:["$","p",null,{"children":"Let’s ground this with an example: identifying whether a portrait is Abraham Lincoln or George Washington. Humans rely on distinctive features such as:"}]
ab:["$","ul",null,{"children":["\n",["$","li",null,{"children":"Facial structure"}],"\n",["$","li",null,{"children":"Hairstyle"}],"\n",["$","li",null,{"children":"Beard or lack thereof"}],"\n",["$","li",null,{"children":"Historical clothing artifacts"}],"\n"]}]
ac:["$","p",null,{"children":["For a machine to do this, it must also extract features — but unlike humans, it needs these features to be either ",["$","strong",null,{"children":"explicitly defined"}]," or ",["$","strong",null,{"children":"automatically learned"}],"."]}]
ad:["$","p",null,{"children":["This brings us to the heart of deep learning for vision: ",["$","strong",null,{"children":"representation learning"}],"."]}]
ae:["$","p",null,{"children":"Neural networks learn to extract features from raw pixels through successive layers of:"}]
af:["$","ul",null,{"children":["\n",["$","li",null,{"children":["\n",["$","p",null,{"children":["$","strong",null,{"children":"Convolution"}]}],"\n"]}],"\n",["$","li",null,{"children":["\n",["$","p",null,{"children":["$","strong",null,{"children":"Pooling"}]}],"\n"]}],"\n",["$","li",null,{"children":["\n",["$","p",null,{"children":["$","strong",null,{"children":"Non-linear transformation"}]}],"\n"]}],"\n",["$","li",null,{"children":["\n",["$","p",null,{"children":["Lower layers capture ",["$","strong",null,{"children":"local edges and textures"}],"."]}],"\n"]}],"\n",["$","li",null,{"children":["\n",["$","p",null,{"children":["Deeper layers capture ",["$","strong",null,{"children":"higher-level abstractions"}]," such as facial parts or spatial arrangements."]}],"\n"]}],"\n"]}]
b0:["$","p",null,{"children":"By learning a hierarchy of features, the network becomes capable of associating specific patterns with specific labels."}]
b1:["$","hr",null,{}]
b2:["$","h2",null,{"className":"flex scroll-m-28 flex-row items-center gap-2","id":"summary","children":[["$","a",null,{"data-card":"","href":"#summary","className":"peer","children":"Summary"}],["$","svg",null,{"ref":"$undefined","xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide size-3.5 shrink-0 text-fd-muted-foreground opacity-0 transition-opacity peer-hover:opacity-100","aria-label":"Link to section","children":[[["$","path","1cjeqo",{"d":"M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"}],["$","path","19qd67",{"d":"M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"}]],"$undefined"]}]]}]
b3:["$","p",null,{"children":["In this chapter, we have laid the foundation for understanding how deep learning systems interpret images. The pipeline begins with raw pixel arrays and flows into two core types of learning problems: ",["$","strong",null,{"children":"regression"}]," and ",["$","strong",null,{"children":"classification"}],"."]}]
b4:["$","h3",null,{"className":"flex scroll-m-28 flex-row items-center gap-2","id":"key-insights","children":[["$","a",null,{"data-card":"","href":"#key-insights","className":"peer","children":"Key insights:"}],["$","svg",null,{"ref":"$undefined","xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide size-3.5 shrink-0 text-fd-muted-foreground opacity-0 transition-opacity peer-hover:opacity-100","aria-label":"Link to section","children":[[["$","path","1cjeqo",{"d":"M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"}],["$","path","19qd67",{"d":"M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"}]],"$undefined"]}]]}]
b5:["$","ul",null,{"children":["\n",["$","li",null,{"children":["Images are ",["$","strong",null,{"children":"structured arrays of numbers"}],", inherently suitable for machine interpretation."]}],"\n",["$","li",null,{"children":["Classification tasks require models to ",["$","strong",null,{"children":"detect and leverage features"}]," that separate one class from another."]}],"\n",["$","li",null,{"children":["Deep networks automate this ",["$","strong",null,{"children":"feature extraction"}]," through layers of learned filters, enabling models to understand visual patterns with increasing abstraction.\n",["$","$L19e",null,{"sizes":"(max-width: 768px) 100vw, (max-width: 1200px) 70vw, 900px","src":"./image_cnn_6.png","alt":"This is an ALT text","className":"rounded-lg"}]]}],"\n"]}]
b6:["$","h1",null,{"className":"flex scroll-m-28 flex-row items-center gap-2","id":"chapter-4-the-challenge-and-power-of-feature-detection","children":[["$","a",null,{"data-card":"","href":"#chapter-4-the-challenge-and-power-of-feature-detection","className":"peer","children":"Chapter 4: The Challenge and Power of Feature Detection"}],["$","svg",null,{"ref":"$undefined","xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide size-3.5 shrink-0 text-fd-muted-foreground opacity-0 transition-opacity peer-hover:opacity-100","aria-label":"Link to section","children":[[["$","path","1cjeqo",{"d":"M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"}],["$","path","19qd67",{"d":"M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"}]],"$undefined"]}]]}]
b7:["$","h2",null,{"className":"flex scroll-m-28 flex-row items-center gap-2","id":"the-essence-of-visual-classification","children":[["$","a",null,{"data-card":"","href":"#the-essence-of-visual-classification","className":"peer","children":"The Essence of Visual Classification"}],["$","svg",null,{"ref":"$undefined","xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide size-3.5 shrink-0 text-fd-muted-foreground opacity-0 transition-opacity peer-hover:opacity-100","aria-label":"Link to section","children":[[["$","path","1cjeqo",{"d":"M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"}],["$","path","19qd67",{"d":"M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"}]],"$undefined"]}]]}]
b8:["$","p",null,{"children":["At the heart of any image classification problem lies the task of feature detection. Fundamentally, classification is a two-step process:",["$","br",null,{}],"\n","Define what you are trying to detect.",["$","br",null,{}],"\n","Detects those features in new images."]}]
b9:["$","p",null,{"children":"For instance, if you are trying to classify an image as a human face, you might define the necessary features as eyes, a nose, and a mouth. Once these components are detected in the image, you gain confidence that the object is indeed a face. Similarly, if you are trying to detect a house, you might define features such as doors, windows, and rooftops. The more of these features the system detects, the more confident it becomes in its classification."}]
ba:["$","p",null,{"children":"This process may appear intuitive, but building a system that performs it reliably across diverse inputs is highly nontrivial."}]
bb:["$","h2",null,{"className":"flex scroll-m-28 flex-row items-center gap-2","id":"why-feature-detection-is-harder-than-it-looks","children":[["$","a",null,{"data-card":"","href":"#why-feature-detection-is-harder-than-it-looks","className":"peer","children":"Why Feature Detection is Harder Than It Looks"}],["$","svg",null,{"ref":"$undefined","xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide size-3.5 shrink-0 text-fd-muted-foreground opacity-0 transition-opacity peer-hover:opacity-100","aria-label":"Link to section","children":[[["$","path","1cjeqo",{"d":"M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"}],["$","path","19qd67",{"d":"M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"}]],"$undefined"]}]]}]
bc:["$","p",null,{"children":["The difficulty arises from two core challenges:",["$","br",null,{}],"\n",["$","strong",null,{"children":"Feature Hierarchy and Recursion"}]]}]
bd:["$","ul",null,{"children":["\n",["$","li",null,{"children":"To detect a face, you must detect eyes."}],"\n",["$","li",null,{"children":"But to detect eyes, you now have a subproblem that is structurally identical to the original problem."}],"\n",["$","li",null,{"children":"Each feature itself requires its own sub-feature detection process."}],"\n",["$","li",null,{"children":"This introduces a hierarchical structure where higher-level features are composed of lower-level ones."}],"\n"]}]
be:["$","p",null,{"children":["$","strong",null,{"children":"High Variability in Input Space"}]}]
bf:["$","p",null,{"children":"A single object class, such as a face, can appear vastly different depending on:"}]
c0:["$","ul",null,{"children":["\n",["$","li",null,{"children":"Lighting conditions"}],"\n",["$","li",null,{"children":"Pose and orientation"}],"\n",["$","li",null,{"children":"Occlusion (e.g. sunglasses, hats, shadows)"}],"\n",["$","li",null,{"children":"Camera sensor differences"}],"\n",["$","li",null,{"children":"Scale and resolution"}],"\n"]}]
c1:["$","p",null,{"children":["In raw pixel space, even small transformations can lead to large changes in numerical values.",["$","br",null,{}],"\n","This makes it hard for classical machine learning models to generalize, as they are sensitive to exact pixel patterns."]}]
c2:["$","h2",null,{"className":"flex scroll-m-28 flex-row items-center gap-2","id":"the-limitations-of-classical-machine-learning","children":[["$","a",null,{"data-card":"","href":"#the-limitations-of-classical-machine-learning","className":"peer","children":"The Limitations of Classical Machine Learning"}],["$","svg",null,{"ref":"$undefined","xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide size-3.5 shrink-0 text-fd-muted-foreground opacity-0 transition-opacity peer-hover:opacity-100","aria-label":"Link to section","children":[[["$","path","1cjeqo",{"d":"M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"}],["$","path","19qd67",{"d":"M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"}]],"$undefined"]}]]}]
c3:["$","p",null,{"children":["In traditional machine learning, feature engineering is a manual process.",["$","br",null,{}],"\n","Domain experts are responsible for defining what to look for in the data. For image tasks, this means designing filters or extracting geometric and statistical descriptors like SIFT, HOG, or edge detectors.",["$","br",null,{}],"\n","While effective in constrained settings, this approach fails under real-world variation. It lacks adaptability and requires constant tweaking for new tasks or domains."]}]
c4:["$","p",null,{"children":"Most importantly, these hand-engineered pipelines are brittle. If the features are poorly chosen or do not generalize, the performance collapses. The system’s success depends entirely on human insight and intuition."}]
c5:["$","h2",null,{"className":"flex scroll-m-28 flex-row items-center gap-2","id":"deep-learning-as-the-paradigm-shift","children":[["$","a",null,{"data-card":"","href":"#deep-learning-as-the-paradigm-shift","className":"peer","children":"Deep Learning as the Paradigm Shift"}],["$","svg",null,{"ref":"$undefined","xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide size-3.5 shrink-0 text-fd-muted-foreground opacity-0 transition-opacity peer-hover:opacity-100","aria-label":"Link to section","children":[[["$","path","1cjeqo",{"d":"M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"}],["$","path","19qd67",{"d":"M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"}]],"$undefined"]}]]}]
c6:["$","p",null,{"children":["Deep learning offers a different philosophy. Instead of explicitly defining features, we learn them from data.",["$","br",null,{}],"\n","Convolutional neural networks (CNNs), the backbone of modern computer vision, are structured to automatically learn hierarchical features from raw pixels. Lower layers learn edges and textures. Middle layers capture parts and shapes. Higher layers learn object-level abstractions.",["$","br",null,{}],"\n","This automatic feature learning solves both core problems outlined earlier:"]}]
c7:["$","ul",null,{"children":["\n",["$","li",null,{"children":"Hierarchy is built into the model architecture through stacked layers."}],"\n",["$","li",null,{"children":"Invariance is achieved by training on diverse data and learning filters that generalize across scale, rotation, brightness, and more."}],"\n"]}]
c8:["$","p",null,{"children":"What was previously a manual, error-prone, and brittle process is now a scalable, data-driven, and highly robust pipeline."}]
c9:["$","h2",null,{"className":"flex scroll-m-28 flex-row items-center gap-2","id":"summary-1","children":[["$","a",null,{"data-card":"","href":"#summary-1","className":"peer","children":"Summary"}],["$","svg",null,{"ref":"$undefined","xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide size-3.5 shrink-0 text-fd-muted-foreground opacity-0 transition-opacity peer-hover:opacity-100","aria-label":"Link to section","children":[[["$","path","1cjeqo",{"d":"M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"}],["$","path","19qd67",{"d":"M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"}]],"$undefined"]}]]}]
ca:["$","p",null,{"children":["Feature detection is the bottleneck in classical machine learning for computer vision.",["$","br",null,{}],"\n","Real-world classification tasks involve massive input variation and hierarchical dependencies.",["$","br",null,{}],"\n","Deep learning replaces hand-crafted feature engineering with automatic representation learning.",["$","br",null,{}],"\n","This shift enables scalable, general-purpose models that outperform classical methods in virtually every vision benchmark."]}]
cb:["$","p",null,{"children":["As we move forward, we will dive into how convolutional layers are specifically designed to perform this automatic feature extraction process with mathematical precision and computational efficiency.\n",["$","$L19e",null,{"sizes":"(max-width: 768px) 100vw, (max-width: 1200px) 70vw, 900px","src":"./image_cnn_7.png","alt":"This is an ALT text","className":"rounded-lg"}],"\n",["$","$L19e",null,{"sizes":"(max-width: 768px) 100vw, (max-width: 1200px) 70vw, 900px","src":"./image_cnn_8.png","alt":"This is an ALT text","className":"rounded-lg"}]]}]
cc:["$","h1",null,{"className":"flex scroll-m-28 flex-row items-center gap-2","id":"chapter-5-learning-features-directly-from-data-with-neural-networks","children":[["$","a",null,{"data-card":"","href":"#chapter-5-learning-features-directly-from-data-with-neural-networks","className":"peer","children":"Chapter 5: Learning Features Directly from Data with Neural Networks"}],["$","svg",null,{"ref":"$undefined","xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide size-3.5 shrink-0 text-fd-muted-foreground opacity-0 transition-opacity peer-hover:opacity-100","aria-label":"Link to section","children":[[["$","path","1cjeqo",{"d":"M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"}],["$","path","19qd67",{"d":"M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"}]],"$undefined"]}]]}]
cd:["$","h2",null,{"className":"flex scroll-m-28 flex-row items-center gap-2","id":"moving-beyond-human-defined-features","children":[["$","a",null,{"data-card":"","href":"#moving-beyond-human-defined-features","className":"peer","children":"Moving Beyond Human-Defined Features"}],["$","svg",null,{"ref":"$undefined","xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide size-3.5 shrink-0 text-fd-muted-foreground opacity-0 transition-opacity peer-hover:opacity-100","aria-label":"Link to section","children":[[["$","path","1cjeqo",{"d":"M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"}],["$","path","19qd67",{"d":"M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"}]],"$undefined"]}]]}]
ce:["$","p",null,{"children":"Traditionally, computer vision systems depended on human-designed feature extractors. A developer might explicitly define that to detect a face, one must first detect eyes, ears, and noses. To go further, they might break those down even more — for instance, to detect an ear, look for a vertical line followed by a semicircle."}]
cf:["$","p",null,{"children":["This recursive manual engineering is fragile, time-consuming, and hard to generalize. What if, instead, we could eliminate this step entirely?",["$","br",null,{}],"\n","This is exactly what deep learning enables. Rather than define features, we learn them directly from raw data.",["$","br",null,{}],"\n","The new paradigm:",["$","br",null,{}],"\n","Feed the model a large dataset of images (e.g. faces).",["$","br",null,{}],"\n","Let the model figure out which patterns of pixels are most useful for distinguishing these images from others (e.g. cars, trees, or other objects).",["$","br",null,{}],"\n","Do this automatically, across many layers, with increasing abstraction."]}]
d0:["$","hr",null,{}]
d1:["$","h2",null,{"className":"flex scroll-m-28 flex-row items-center gap-2","id":"hierarchy-through-depth","children":[["$","a",null,{"data-card":"","href":"#hierarchy-through-depth","className":"peer","children":"Hierarchy Through Depth"}],["$","svg",null,{"ref":"$undefined","xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide size-3.5 shrink-0 text-fd-muted-foreground opacity-0 transition-opacity peer-hover:opacity-100","aria-label":"Link to section","children":[[["$","path","1cjeqo",{"d":"M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"}],["$","path","19qd67",{"d":"M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"}]],"$undefined"]}]]}]
d2:["$","p",null,{"children":["The key architectural insight lies in depth. A neural network is composed of many layers, each transforming the image representation in a structured, learnable way.",["$","br",null,{}],"\n","Early layers learn simple features like edges and textures.",["$","br",null,{}],"\n","Middle layers build on these to form motifs like eyes, wheels, or leaf patterns.",["$","br",null,{}],"\n","Deeper layers combine these motifs into object-level understanding — faces, vehicles, animals, etc."]}]
d3:["$","p",null,{"children":["This progression is not manually programmed. It emerges from training data through backpropagation and gradient descent.",["$","br",null,{}],"\n","Each layer's role is to extract more abstract, more informative features from the layer below it. The deeper the network, the more complex the learned representations become."]}]
d4:["$","hr",null,{}]
d5:["$","h2",null,{"className":"flex scroll-m-28 flex-row items-center gap-2","id":"why-this-works","children":[["$","a",null,{"data-card":"","href":"#why-this-works","className":"peer","children":"Why This Works"}],["$","svg",null,{"ref":"$undefined","xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide size-3.5 shrink-0 text-fd-muted-foreground opacity-0 transition-opacity peer-hover:opacity-100","aria-label":"Link to section","children":[[["$","path","1cjeqo",{"d":"M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"}],["$","path","19qd67",{"d":"M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"}]],"$undefined"]}]]}]
d6:["$","p",null,{"children":["The power of this approach lies in the distributed and compositional nature of representations in deep neural networks:",["$","br",null,{}],"\n",["$","strong",null,{"children":"Distributed:"}],["$","br",null,{}],"\n","No single neuron defines a concept. Instead, many neurons jointly encode patterns.",["$","br",null,{}],"\n",["$","strong",null,{"children":"Compositional:"}],["$","br",null,{}],"\n","High-level features are composed of lower-level ones, learned through successive transformations."]}]
d7:["$","p",null,{"children":["What makes this powerful in vision is the sheer variability in how objects appear: lighting, pose, occlusion, and background noise. Instead of hand-coding every edge case, we allow the model to generalize from examples.",["$","br",null,{}],"\n","Given enough data and a sufficiently expressive model, the network can learn to tease apart the subtle cues that distinguish one object class from another — without any explicit definition of what a nose, a car, or a building looks like."]}]
d8:["$","hr",null,{}]
d9:["$","h2",null,{"className":"flex scroll-m-28 flex-row items-center gap-2","id":"revisiting-our-example","children":[["$","a",null,{"data-card":"","href":"#revisiting-our-example","className":"peer","children":"Revisiting Our Example"}],["$","svg",null,{"ref":"$undefined","xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide size-3.5 shrink-0 text-fd-muted-foreground opacity-0 transition-opacity peer-hover:opacity-100","aria-label":"Link to section","children":[[["$","path","1cjeqo",{"d":"M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"}],["$","path","19qd67",{"d":"M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"}]],"$undefined"]}]]}]
da:["$","p",null,{"children":["Suppose we want to distinguish faces from cars.",["$","br",null,{}],"\n","In a traditional system, we might specify that faces have eyes, noses, and mouths, and cars have wheels, headlights, and windshields.",["$","br",null,{}],"\n","In a deep learning system, we feed thousands of labeled examples of faces and cars.",["$","br",null,{}],"\n","The network’s convolutional layers learn discriminative patterns at every level — from low-level gradients to high-level semantic structures.",["$","br",null,{}],"\n","Over time, the network builds a hierarchy of features tuned specifically to the task at hand."]}]
db:["$","p",null,{"children":"No manual feature engineering is involved. The data drives the representations."}]
dc:["$","hr",null,{}]
dd:["$","h2",null,{"className":"flex scroll-m-28 flex-row items-center gap-2","id":"summary-2","children":[["$","a",null,{"data-card":"","href":"#summary-2","className":"peer","children":"Summary"}],["$","svg",null,{"ref":"$undefined","xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide size-3.5 shrink-0 text-fd-muted-foreground opacity-0 transition-opacity peer-hover:opacity-100","aria-label":"Link to section","children":[[["$","path","1cjeqo",{"d":"M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"}],["$","path","19qd67",{"d":"M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"}]],"$undefined"]}]]}]
de:["$","p",null,{"children":["Human-defined features are limited by our intuition and manual effort.",["$","br",null,{}],"\n","Neural networks eliminate the need for handcrafted feature pipelines by learning representations directly from data.",["$","br",null,{}],"\n","Hierarchical structure arises naturally from network depth, enabling increasingly abstract features to emerge.",["$","br",null,{}],"\n","This approach makes models more adaptive, more robust to real-world variation, and ultimately more performant across vision tasks."]}]
df:["$","p",null,{"children":["$","$L19e",null,{"sizes":"(max-width: 768px) 100vw, (max-width: 1200px) 70vw, 900px","src":"./image_cnn_9.png","alt":"This is an ALT text","className":"rounded-lg"}]}]
e0:["$","h1",null,{"className":"flex scroll-m-28 flex-row items-center gap-2","id":"chapter-6-preserving-spatial-structure-with-convolutional-neural-networks","children":[["$","a",null,{"data-card":"","href":"#chapter-6-preserving-spatial-structure-with-convolutional-neural-networks","className":"peer","children":"Chapter 6: Preserving Spatial Structure with Convolutional Neural Networks"}],["$","svg",null,{"ref":"$undefined","xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide size-3.5 shrink-0 text-fd-muted-foreground opacity-0 transition-opacity peer-hover:opacity-100","aria-label":"Link to section","children":[[["$","path","1cjeqo",{"d":"M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"}],["$","path","19qd67",{"d":"M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"}]],"$undefined"]}]]}]
e1:["$","h2",null,{"className":"flex scroll-m-28 flex-row items-center gap-2","id":"the-limits-of-fully-connected-networks-in-vision","children":[["$","a",null,{"data-card":"","href":"#the-limits-of-fully-connected-networks-in-vision","className":"peer","children":"The Limits of Fully Connected Networks in Vision"}],["$","svg",null,{"ref":"$undefined","xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide size-3.5 shrink-0 text-fd-muted-foreground opacity-0 transition-opacity peer-hover:opacity-100","aria-label":"Link to section","children":[[["$","path","1cjeqo",{"d":"M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"}],["$","path","19qd67",{"d":"M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"}]],"$undefined"]}]]}]
e2:["$","p",null,{"children":"In Lecture 1, we explored fully connected neural networks  models where each neuron in one layer is connected to every neuron in the previous layer. This structure works well for problems where the input is one-dimensional or where spatial locality is not important."}]
e3:["$","p",null,{"children":["But images are fundamentally different.",["$","br",null,{}],"\n","An image is a two-dimensional structure — width and height (and possibly channels for color). Every pixel has spatial meaning: a pixel next to another shares more visual relevance than one on the opposite side of the image. Flattening this structure into a one-dimensional vector destroys this locality."]}]
e4:["$","p",null,{"children":["Let’s say we flatten a 100×100 image (grayscale). That’s a vector of size 10,000. If our hidden layer has 1,000 neurons, we now have 10 million parameters just between two layers. Worse, we’ve lost all of the rich structure that defines images  edges, shapes, orientation, and locality.",["$","br",null,{}],"\n","This is computationally inefficient and conceptually unsound."]}]
e5:["$","h2",null,{"className":"flex scroll-m-28 flex-row items-center gap-2","id":"what-we-need-instead","children":[["$","a",null,{"data-card":"","href":"#what-we-need-instead","className":"peer","children":"What We Need Instead"}],["$","svg",null,{"ref":"$undefined","xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide size-3.5 shrink-0 text-fd-muted-foreground opacity-0 transition-opacity peer-hover:opacity-100","aria-label":"Link to section","children":[[["$","path","1cjeqo",{"d":"M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"}],["$","path","19qd67",{"d":"M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"}]],"$undefined"]}]]}]
e6:["$","p",null,{"children":"To model vision tasks effectively, we need a network architecture that:"}]
e7:["$","ul",null,{"children":["\n",["$","li",null,{"children":"Preserves the spatial arrangement of pixels"}],"\n",["$","li",null,{"children":"Maintains local connectivity (pixels that are near each other matter most)"}],"\n",["$","li",null,{"children":"Is parameter-efficient, sharing computations across regions of the image"}],"\n",["$","li",null,{"children":"Builds hierarchical features, where local patterns form edges, shapes, and entire objects"}],"\n"]}]
e8:["$","p",null,{"children":"This is the idea behind Convolutional Neural Networks (CNNs)."}]
e9:["$","h2",null,{"className":"flex scroll-m-28 flex-row items-center gap-2","id":"local-connectivity-and-weight-sharing","children":[["$","a",null,{"data-card":"","href":"#local-connectivity-and-weight-sharing","className":"peer","children":"Local Connectivity and Weight Sharing"}],["$","svg",null,{"ref":"$undefined","xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide size-3.5 shrink-0 text-fd-muted-foreground opacity-0 transition-opacity peer-hover:opacity-100","aria-label":"Link to section","children":[[["$","path","1cjeqo",{"d":"M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"}],["$","path","19qd67",{"d":"M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"}]],"$undefined"]}]]}]
ea:["$","p",null,{"children":"Instead of connecting every input pixel to every neuron in the next layer, CNNs use local receptive fields in small patches of the input image."}]
eb:["$","p",null,{"children":"Let’s say we use a filter (also called a kernel) of size 4×4. This filter is a small set of weights (just 16 numbers) that will be applied across the image:"}]
ec:["$","ul",null,{"children":["\n",["$","li",null,{"children":"The first output neuron in the next layer is computed by applying this filter to the top-left 4×4 patch of the image."}],"\n",["$","li",null,{"children":"The next neuron is computed by applying the same filter to the next 4×4 patch, shifted one pixel to the right."}],"\n",["$","li",null,{"children":"This continues across the entire image."}],"\n"]}]
ed:["$","p",null,{"children":["This operation is called a convolution.",["$","br",null,{}],"\n",["$","strong",null,{"children":"Key characteristics:"}]]}]
ee:["$","ul",null,{"children":["\n",["$","li",null,{"children":[["$","strong",null,{"children":"Locality:"}],["$","br",null,{}],"\n","Each neuron sees only a small patch of the input (local features)."]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"Weight sharing:"}],["$","br",null,{}],"\n","The same filter is used everywhere in the image, which drastically reduces parameters."]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"Translation invariance:"}],["$","br",null,{}],"\n","Because the same filter is applied across locations, the network can detect a pattern regardless of where it occurs."]}],"\n"]}]
ef:["$","p",null,{"children":"This is fundamentally different from fully connected layers, where each neuron has a separate weight for every input pixel."}]
f0:["$","h2",null,{"className":"flex scroll-m-28 flex-row items-center gap-2","id":"what-is-a-convolution","children":[["$","a",null,{"data-card":"","href":"#what-is-a-convolution","className":"peer","children":"What is a Convolution?"}],["$","svg",null,{"ref":"$undefined","xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide size-3.5 shrink-0 text-fd-muted-foreground opacity-0 transition-opacity peer-hover:opacity-100","aria-label":"Link to section","children":[[["$","path","1cjeqo",{"d":"M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"}],["$","path","19qd67",{"d":"M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"}]],"$undefined"]}]]}]
f1:["$","p",null,{"children":["A convolution is a sliding, element-wise multiplication operation followed by a sum, bias addition, and nonlinearity.",["$","br",null,{}],"\n","Here’s how it works:"]}]
f2:["$","ul",null,{"children":["\n",["$","li",null,{"children":"Take a small patch of the input image — say, a 4×4 region."}],"\n",["$","li",null,{"children":"Multiply it element-wise with the 4×4 filter."}],"\n",["$","li",null,{"children":"Sum the result into a single number."}],"\n",["$","li",null,{"children":"Add a bias term."}],"\n",["$","li",null,{"children":"Pass the result through a nonlinearity (like ReLU)."}],"\n",["$","li",null,{"children":"Shift the filter (by a stride of 1 or 2 pixels), and repeat."}],"\n"]}]
f3:["$","p",null,{"children":["The result is a new matrix, called a ",["$","strong",null,{"children":"feature map"}],", which encodes where and how strongly a certain pattern appears in the image.",["$","br",null,{}],"\n","By stacking multiple filters, we extract multiple types of features — edges in different directions, textures, corners, etc."]}]
f4:["$","h2",null,{"className":"flex scroll-m-28 flex-row items-center gap-2","id":"why-convolutions-work-so-well","children":[["$","a",null,{"data-card":"","href":"#why-convolutions-work-so-well","className":"peer","children":"Why Convolutions Work So Well"}],["$","svg",null,{"ref":"$undefined","xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide size-3.5 shrink-0 text-fd-muted-foreground opacity-0 transition-opacity peer-hover:opacity-100","aria-label":"Link to section","children":[[["$","path","1cjeqo",{"d":"M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"}],["$","path","19qd67",{"d":"M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"}]],"$undefined"]}]]}]
f5:["$","p",null,{"children":"CNNs introduce inductive biases that are well-aligned with how real-world images behave:"}]
f6:["$","ul",null,{"children":["\n",["$","li",null,{"children":[["$","strong",null,{"children":"Locality bias:"}],["$","br",null,{}],"\n","Nearby pixels are more related than distant ones."]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"Translation equivariance:"}],["$","br",null,{}],"\n","A pattern (like an eye) means the same thing regardless of where it appears."]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"Parameter sharing:"}],["$","br",null,{}],"\n","Learning one set of weights that can generalize across the input space makes the model more efficient and data-hungry."]}],"\n"]}]
f7:["$","p",null,{"children":"Over multiple layers, CNNs form hierarchies of features:"}]
f8:["$","ul",null,{"children":["\n",["$","li",null,{"children":[["$","strong",null,{"children":"Layer 1:"}]," local edge detectors (like Sobel filters)"]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"Layer 2:"}]," motifs (corners, curves)"]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"Layer 3+:"}]," parts of objects and entire objects (faces, wheels, etc.)"]}],"\n"]}]
f9:["$","p",null,{"children":"This aligns perfectly with how humans understand vision — as a composition of increasingly complex structures."}]
fa:["$","h2",null,{"className":"flex scroll-m-28 flex-row items-center gap-2","id":"summary-3","children":[["$","a",null,{"data-card":"","href":"#summary-3","className":"peer","children":"Summary"}],["$","svg",null,{"ref":"$undefined","xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide size-3.5 shrink-0 text-fd-muted-foreground opacity-0 transition-opacity peer-hover:opacity-100","aria-label":"Link to section","children":[[["$","path","1cjeqo",{"d":"M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"}],["$","path","19qd67",{"d":"M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"}]],"$undefined"]}]]}]
fb:["$","ul",null,{"children":["\n",["$","li",null,{"children":"Flattening images for fully connected layers destroys spatial information and is inefficient."}],"\n",["$","li",null,{"children":"Convolutional layers maintain spatial structure and reduce parameters by using local filters."}],"\n",["$","li",null,{"children":"A convolution is a filter sliding across the image, performing local pattern detection."}],"\n",["$","li",null,{"children":"CNNs exploit properties of images  locality, translation invariance, and shared structure  to build robust visual models."}],"\n"]}]
fc:["$","p",null,{"children":[["$","$L19e",null,{"sizes":"(max-width: 768px) 100vw, (max-width: 1200px) 70vw, 900px","src":"./image_cnn_10.png","alt":"This is an ALT text","className":"rounded-lg"}],"\n",["$","$L19e",null,{"sizes":"(max-width: 768px) 100vw, (max-width: 1200px) 70vw, 900px","src":"./image_cnn_11.png","alt":"This is an ALT text","className":"rounded-lg"}],"\n",["$","$L19e",null,{"sizes":"(max-width: 768px) 100vw, (max-width: 1200px) 70vw, 900px","src":"./image_cnn_12.png","alt":"This is an ALT text","className":"rounded-lg"}],"\n",["$","$L19e",null,{"sizes":"(max-width: 768px) 100vw, (max-width: 1200px) 70vw, 900px","src":"./image_cnn_13.png","alt":"This is an ALT text","className":"rounded-lg"}]]}]
