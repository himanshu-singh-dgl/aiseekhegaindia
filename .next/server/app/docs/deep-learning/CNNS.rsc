fe:["$","h2",null,{"className":"flex scroll-m-28 flex-row items-center gap-2","id":"the-feature-detection-power-of-convolutions","children":[["$","a",null,{"data-card":"","href":"#the-feature-detection-power-of-convolutions","className":"peer","children":"The Feature Detection Power of Convolutions"}],["$","svg",null,{"ref":"$undefined","xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide size-3.5 shrink-0 text-fd-muted-foreground opacity-0 transition-opacity peer-hover:opacity-100","aria-label":"Link to section","children":[[["$","path","1cjeqo",{"d":"M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"}],["$","path","19qd67",{"d":"M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"}]],"$undefined"]}]]}]
ff:["$","p",null,{"children":["So far, we’ve learned that:",["$","br",null,{}],"\n","Fully connected networks discard spatial structure.",["$","br",null,{}],"\n","Convolutions preserve it by operating locally.",["$","br",null,{}],"\n","Each filter detects a specific pattern by sliding over the image."]}]
100:["$","p",null,{"children":["But how exactly does a filter detect features like edges, textures, or shapes?",["$","br",null,{}],"\n","Let’s answer that through an example."]}]
101:["$","h2",null,{"className":"flex scroll-m-28 flex-row items-center gap-2","id":"detecting-shapes-the-case-of-an-x","children":[["$","a",null,{"data-card":"","href":"#detecting-shapes-the-case-of-an-x","className":"peer","children":"Detecting Shapes: The Case of an “X”"}],["$","svg",null,{"ref":"$undefined","xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide size-3.5 shrink-0 text-fd-muted-foreground opacity-0 transition-opacity peer-hover:opacity-100","aria-label":"Link to section","children":[[["$","path","1cjeqo",{"d":"M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"}],["$","path","19qd67",{"d":"M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"}]],"$undefined"]}]]}]
102:["$","p",null,{"children":"Suppose you're trying to detect whether an image contains an X — not necessarily centered, possibly rotated or distorted. You could:"}]
103:["$","ul",null,{"children":["\n",["$","li",null,{"children":"Compare the input image pixel by pixel with a prototype X (but this fails under deformation),"}],"\n",["$","li",null,{"children":["Or, break the image into patches, and search for elemental components of an X:","\n",["$","ul",null,{"children":["\n",["$","li",null,{"children":"a forward diagonal"}],"\n",["$","li",null,{"children":"a backward diagonal"}],"\n",["$","li",null,{"children":"a crossing pattern"}],"\n"]}],"\n"]}],"\n"]}]
104:["$","p",null,{"children":["Instead of recognizing the full structure all at once, we detect and recombine parts of it.",["$","br",null,{}],"\n","These elemental detectors are what filters are for. Each filter is a small matrix (e.g., 3×3) that looks for a basic pattern:"]}]
105:["$","ul",null,{"children":["\n",["$","li",null,{"children":"A diagonal line"}],"\n",["$","li",null,{"children":"A vertical edge"}],"\n",["$","li",null,{"children":"A horizontal transition"}],"\n",["$","li",null,{"children":"A corner"}],"\n"]}]
106:["$","p",null,{"children":"These filters are our learned eyes — they decide what to look for in the data."}]
