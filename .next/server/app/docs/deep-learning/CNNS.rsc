133:["$","ul",null,{"children":["\n",["$","li",null,{"children":"The image is input."}],"\n",["$","li",null,{"children":"The filters (also called kernels) are slid over the image to compute feature maps via convolution."}],"\n",["$","li",null,{"children":"The resulting numbers capture the presence (or absence) of specific patterns (edges, corners, etc.) in the image."}],"\n"]}]
134:["$","p",null,{"children":["But so far, we assumed we had those filters. In real CNNs:",["$","br",null,{}],"\n",["$","strong",null,{"children":"We learn those filters automatically from data."}]]}]
