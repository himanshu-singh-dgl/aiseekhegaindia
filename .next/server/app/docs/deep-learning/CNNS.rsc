137:["$","p",null,{"children":"There are three core operations you’ll repeatedly see in CNNs:"}]
138:["$","h3",null,{"className":"flex scroll-m-28 flex-row items-center gap-2","id":"i-convolution","children":[["$","a",null,{"data-card":"","href":"#i-convolution","className":"peer","children":"(i) Convolution"}],["$","svg",null,{"ref":"$undefined","xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide size-3.5 shrink-0 text-fd-muted-foreground opacity-0 transition-opacity peer-hover:opacity-100","aria-label":"Link to section","children":[[["$","path","1cjeqo",{"d":"M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"}],["$","path","19qd67",{"d":"M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"}]],"$undefined"]}]]}]
139:["$","ul",null,{"children":["\n",["$","li",null,{"children":"Captures local features."}],"\n",["$","li",null,{"children":"Each filter learns to detect a specific pattern (edge, texture, shape)."}],"\n",["$","li",null,{"children":"Produces multiple feature maps, each indicating where that pattern appears."}],"\n"]}]
13a:["$","h3",null,{"className":"flex scroll-m-28 flex-row items-center gap-2","id":"ii-relu-nonlinearity-eg-relu-rectified-linear-unit","children":[["$","a",null,{"data-card":"","href":"#ii-relu-nonlinearity-eg-relu-rectified-linear-unit","className":"peer","children":"(ii) ReLU: Nonlinearity (e.g., ReLU) Rectified Linear Unit"}],["$","svg",null,{"ref":"$undefined","xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide size-3.5 shrink-0 text-fd-muted-foreground opacity-0 transition-opacity peer-hover:opacity-100","aria-label":"Link to section","children":[[["$","path","1cjeqo",{"d":"M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"}],["$","path","19qd67",{"d":"M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"}]],"$undefined"]}]]}]
13b:["$","ul",null,{"children":["\n",["$","li",null,{"children":"Applies an activation function to the feature map output."}],"\n",["$","li",null,{"children":"ReLU sets all negative values to zero (like a threshold gate)."}],"\n",["$","li",null,{"children":"This nonlinearity makes the network expressive, i.e., capable of learning complex, nonlinear patterns."}],"\n"]}]
13c:["$","h3",null,{"className":"flex scroll-m-28 flex-row items-center gap-2","id":"iii-pooling-downsampling","children":[["$","a",null,{"data-card":"","href":"#iii-pooling-downsampling","className":"peer","children":"(iii) Pooling (Downsampling)"}],["$","svg",null,{"ref":"$undefined","xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide size-3.5 shrink-0 text-fd-muted-foreground opacity-0 transition-opacity peer-hover:opacity-100","aria-label":"Link to section","children":[[["$","path","1cjeqo",{"d":"M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"}],["$","path","19qd67",{"d":"M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"}]],"$undefined"]}]]}]
13d:["$","ul",null,{"children":["\n",["$","li",null,{"children":"Reduces the spatial dimensions (e.g., 28×28 → 14×14)."}],"\n",["$","li",null,{"children":"Helps reduce computation and introduces invariance to small translations/rotations."}],"\n",["$","li",null,{"children":["Common: ",["$","strong",null,{"children":"Max pooling"}],", which retains only the max value in each small window."]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"Mean Pooling"}],": averages out the whole matrix and preserves the mean/avg instead of max."]}],"\n"]}]
13e:["$","p",null,{"children":"These steps repeat across layers, allowing the network to learn increasingly abstract and complex representations."}]
13f:["$","hr",null,{}]
140:["$","h2",null,{"className":"flex scroll-m-28 flex-row items-center gap-2","id":"local-connectivity--hierarchical-features","children":[["$","a",null,{"data-card":"","href":"#local-connectivity--hierarchical-features","className":"peer","children":"Local Connectivity + Hierarchical Features"}],["$","svg",null,{"ref":"$undefined","xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide size-3.5 shrink-0 text-fd-muted-foreground opacity-0 transition-opacity peer-hover:opacity-100","aria-label":"Link to section","children":[[["$","path","1cjeqo",{"d":"M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"}],["$","path","19qd67",{"d":"M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"}]],"$undefined"]}]]}]
141:["$","p",null,{"children":["CNNs exploit local connectivity: each neuron only “sees” a small patch of the image.",["$","br",null,{}],"\n","However, by stacking multiple convolution layers, the effective receptive field grows:"]}]
142:["$","ul",null,{"children":["\n",["$","li",null,{"children":[["$","strong",null,{"children":"Layer 1"}]," learns edges (horizontal, vertical, diagonal)."]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"Layer 2"}]," learns combinations of those edges (corners, curves)."]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"Layer 3+"}]," starts recognizing more semantic features (eyes, faces, objects)."]}],"\n"]}]
143:["$","p",null,{"children":["This is ",["$","strong",null,{"children":"hierarchical feature extraction"}],", a key power of CNNs."]}]
144:["$","hr",null,{}]
145:["$","h2",null,{"className":"flex scroll-m-28 flex-row items-center gap-2","id":"multiple-filters-per-layer--feature-volume","children":[["$","a",null,{"data-card":"","href":"#multiple-filters-per-layer--feature-volume","className":"peer","children":"Multiple Filters per Layer = Feature Volume"}],["$","svg",null,{"ref":"$undefined","xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide size-3.5 shrink-0 text-fd-muted-foreground opacity-0 transition-opacity peer-hover:opacity-100","aria-label":"Link to section","children":[[["$","path","1cjeqo",{"d":"M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"}],["$","path","19qd67",{"d":"M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"}]],"$undefined"]}]]}]
146:["$","p",null,{"children":["Each conv layer learns not one, but many filters—each producing its own feature map.",["$","br",null,{}],"\n","Stacking all of these maps together gives a ",["$","strong",null,{"children":"feature volume"}]," (like a 3D tensor)."]}]
147:["$","p",null,{"children":["$","strong",null,{"children":"Example:"}]}]
148:["$","ul",null,{"children":["\n",["$","li",null,{"children":"Input: (32×32×3) image (RGB)"}],"\n",["$","li",null,{"children":"Conv Layer 1 applies 16 filters → Output: (30×30×16)"}],"\n",["$","li",null,{"children":"Next conv layer may apply 32 filters → Output: (28×28×32), and so on..."}],"\n"]}]
149:["$","p",null,{"children":["The ",["$","strong",null,{"children":"depth increases"}],", but the ",["$","strong",null,{"children":"height/width may decrease via pooling"}],"."]}]
14a:["$","hr",null,{}]
14b:["$","h2",null,{"className":"flex scroll-m-28 flex-row items-center gap-2","id":"training-how-filters-are-learned","children":[["$","a",null,{"data-card":"","href":"#training-how-filters-are-learned","className":"peer","children":"Training: How Filters Are Learned"}],["$","svg",null,{"ref":"$undefined","xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide size-3.5 shrink-0 text-fd-muted-foreground opacity-0 transition-opacity peer-hover:opacity-100","aria-label":"Link to section","children":[[["$","path","1cjeqo",{"d":"M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"}],["$","path","19qd67",{"d":"M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"}]],"$undefined"]}]]}]
14c:["$","p",null,{"children":["Filters (i.e., weights of the convolution kernels) are learned via ",["$","strong",null,{"children":"gradient descent"}],".",["$","br",null,{}],"\n",["$","strong",null,{"children":"How?"}]]}]
14d:["$","ol",null,{"children":["\n",["$","li",null,{"children":"The network makes a prediction (e.g., \"this is a cat\")."}],"\n",["$","li",null,{"children":"If it's wrong, a loss is calculated."}],"\n",["$","li",null,{"children":"The error is back-propagated through the network."}],"\n",["$","li",null,{"children":"This updates the filters to reduce future error."}],"\n"]}]
14e:["$","p",null,{"children":["So over time, ",["$","strong",null,{"children":"filters specialize to detect patterns most useful for distinguishing between the target classes"}],"."]}]
14f:["$","hr",null,{}]
