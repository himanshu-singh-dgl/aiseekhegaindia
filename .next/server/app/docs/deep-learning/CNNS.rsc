70:["$","h2",null,{"className":"flex scroll-m-28 flex-row items-center gap-2","id":"what-is-vision-conceptually","children":[["$","a",null,{"data-card":"","href":"#what-is-vision-conceptually","className":"peer","children":"What is Vision, Conceptually?"}],["$","svg",null,{"ref":"$undefined","xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide size-3.5 shrink-0 text-fd-muted-foreground opacity-0 transition-opacity peer-hover:opacity-100","aria-label":"Link to section","children":[[["$","path","1cjeqo",{"d":"M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"}],["$","path","19qd67",{"d":"M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"}]],"$undefined"]}]]}]
71:["$","p",null,{"children":["At its most essential definition, ",["$","strong",null,{"children":"vision is the ability to determine \"what is where by looking.\""}]," But this deceptively simple idea hides immense complexity. Consider how much context you subconsciously interpret when looking at a single image:"]}]
72:["$","ul",null,{"children":["\n",["$","li",null,{"children":"What objects are present?"}],"\n",["$","li",null,{"children":"Where are they located?"}],"\n",["$","li",null,{"children":"Are they moving or stationary?"}],"\n",["$","li",null,{"children":"What are their relationships to each other?"}],"\n",["$","li",null,{"children":"What might happen next?"}],"\n"]}]
73:["$","p",null,{"children":["This act of perception isn’t just about labeling pixels — it involves ",["$","strong",null,{"children":"spatial reasoning"}],", ",["$","strong",null,{"children":"temporal inference"}],", and even ",["$","strong",null,{"children":"predictive modeling"}],"."]}]
74:["$","hr",null,{}]
75:["$","h2",null,{"className":"flex scroll-m-28 flex-row items-center gap-2","id":"static-vs-dynamic-perception","children":[["$","a",null,{"data-card":"","href":"#static-vs-dynamic-perception","className":"peer","children":"Static vs. Dynamic Perception"}],["$","svg",null,{"ref":"$undefined","xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide size-3.5 shrink-0 text-fd-muted-foreground opacity-0 transition-opacity peer-hover:opacity-100","aria-label":"Link to section","children":[[["$","path","1cjeqo",{"d":"M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"}],["$","path","19qd67",{"d":"M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"}]],"$undefined"]}]]}]
76:["$","p",null,{"children":["Human vision doesn’t just recognize objects statically; it understands them ",["$","strong",null,{"children":"dynamically"}],". For instance, consider an urban street scene:"]}]
77:["$","ul",null,{"children":["\n",["$","li",null,{"children":["A white van parked on the left side of the road is understood to be ",["$","strong",null,{"children":"static"}],"."]}],"\n",["$","li",null,{"children":["A sedan in motion in the same frame is interpreted ",["$","strong",null,{"children":"differently"}]," — even though both are visually \"cars.\""]}],"\n",["$","li",null,{"children":["Pedestrians on the sidewalk versus those crossing the street are perceived in terms of ",["$","strong",null,{"children":"action and intention"}],"."]}],"\n",["$","li",null,{"children":["A red traffic light implies ",["$","strong",null,{"children":"upcoming behavior"}]," from moving vehicles."]}],"\n"]}]
78:["$","p",null,{"children":["This is critical: vision is not just about detecting what is in the image — it's also about ",["$","strong",null,{"children":"understanding how things interact over time"}],"."]}]
79:["$","p",null,{"children":["Human vision inherently reasons about ",["$","strong",null,{"children":"temporality"}],", ",["$","strong",null,{"children":"intent"}],", and ",["$","strong",null,{"children":"dynamics"}],", and our goal is to instill a similar ",["$","strong",null,{"children":"representational"}]," and ",["$","strong",null,{"children":"inferential"}]," power in computer vision systems."]}]
7a:["$","hr",null,{}]
7b:["$","h2",null,{"className":"flex scroll-m-28 flex-row items-center gap-2","id":"why-computer-vision-matters","children":[["$","a",null,{"data-card":"","href":"#why-computer-vision-matters","className":"peer","children":"Why Computer Vision Matters"}],["$","svg",null,{"ref":"$undefined","xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide size-3.5 shrink-0 text-fd-muted-foreground opacity-0 transition-opacity peer-hover:opacity-100","aria-label":"Link to section","children":[[["$","path","1cjeqo",{"d":"M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"}],["$","path","19qd67",{"d":"M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"}]],"$undefined"]}]]}]
7c:["$","p",null,{"children":"Computer vision powers real-world applications such as:"}]
7d:["$","ul",null,{"children":["\n",["$","li",null,{"children":[["$","strong",null,{"children":"Autonomous driving"}],": detecting lane boundaries, pedestrians, traffic signs."]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"Medical image analysis"}],": identifying tumors from scans."]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"Augmented reality and robotics"}],": spatial mapping, scene understanding."]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"Industrial automation"}],": defect detection in manufacturing."]}],"\n"]}]
7e:["$","p",null,{"children":["These systems must do more than ",["$","strong",null,{"children":"classify"}]," — they must ",["$","strong",null,{"children":"perceive the scene"}],", ",["$","strong",null,{"children":"predict changes"}],", and ",["$","strong",null,{"children":"react accordingly"}],", all in ",["$","strong",null,{"children":"real-time"}],"."]}]
