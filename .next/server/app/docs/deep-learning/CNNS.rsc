180:["$","h1",null,{"className":"flex scroll-m-28 flex-row items-center gap-2","id":"chapter-10-extending-cnns-beyond-classification","children":[["$","a",null,{"data-card":"","href":"#chapter-10-extending-cnns-beyond-classification","className":"peer","children":"Chapter: 10 Extending CNNs Beyond Classification"}],["$","svg",null,{"ref":"$undefined","xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide size-3.5 shrink-0 text-fd-muted-foreground opacity-0 transition-opacity peer-hover:opacity-100","aria-label":"Link to section","children":[[["$","path","1cjeqo",{"d":"M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"}],["$","path","19qd67",{"d":"M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"}]],"$undefined"]}]]}]
181:["$","h2",null,{"className":"flex scroll-m-28 flex-row items-center gap-2","id":"intuition-behind-cnn-architecture-choices","children":[["$","a",null,{"data-card":"","href":"#intuition-behind-cnn-architecture-choices","className":"peer","children":"Intuition Behind CNN Architecture Choices"}],["$","svg",null,{"ref":"$undefined","xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide size-3.5 shrink-0 text-fd-muted-foreground opacity-0 transition-opacity peer-hover:opacity-100","aria-label":"Link to section","children":[[["$","path","1cjeqo",{"d":"M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"}],["$","path","19qd67",{"d":"M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"}]],"$undefined"]}]]}]
182:["$","p",null,{"children":["Choosing CNN architecture parameters — like patch size, feature dimensions, and layer depth is more of an art guided by intuition and data characteristics than a strict science. For example, using a 3x3 kernel may be appropriate when features are expected to be fine-grained, but this depends heavily on the scale and resolution of the input. For large images, such small patches may not be sufficient to capture meaningful spatial context early in the network. Conversely, for smaller images or those with compact features, even a 3x3 patch may hold significant signal. Always consider the visual semantics your model needs to learn and at what resolution those features are most meaningful.",["$","br",null,{}],"\n","Another important consideration is invariance. If your model is trained on only upright faces, it will likely fail on rotated ones unless rotation is part of your training distribution. The model does not generalize rotationally unless explicitly trained to do so."]}]
183:["$","h2",null,{"className":"flex scroll-m-28 flex-row items-center gap-2","id":"from-classification-to-detection-and-beyond","children":[["$","a",null,{"data-card":"","href":"#from-classification-to-detection-and-beyond","className":"peer","children":"From Classification to Detection and Beyond"}],["$","svg",null,{"ref":"$undefined","xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide size-3.5 shrink-0 text-fd-muted-foreground opacity-0 transition-opacity peer-hover:opacity-100","aria-label":"Link to section","children":[[["$","path","1cjeqo",{"d":"M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"}],["$","path","19qd67",{"d":"M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"}]],"$undefined"]}]]}]
184:["$","p",null,{"children":"CNNs were initially popularized for image classification tasks, but the architecture is flexible and modular. At its core, a CNN can be split into two components: a feature extractor and a task-specific head. The task-specific head can be adapted for a wide range of applications beyond classification, including detection, segmentation, and control."}]
185:["$","h3",null,{"className":"flex scroll-m-28 flex-row items-center gap-2","id":"1-classification","children":[["$","a",null,{"data-card":"","href":"#1-classification","className":"peer","children":"1. Classification"}],["$","svg",null,{"ref":"$undefined","xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide size-3.5 shrink-0 text-fd-muted-foreground opacity-0 transition-opacity peer-hover:opacity-100","aria-label":"Link to section","children":[[["$","path","1cjeqo",{"d":"M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"}],["$","path","19qd67",{"d":"M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"}]],"$undefined"]}]]}]
186:["$","p",null,{"children":"At the most basic level, the CNN extracts features and maps them to class probabilities. For example, a medical imaging CNN might output a binary label indicating the presence or absence of a condition like cancer from a mammogram. The last few layers are usually a flattening operation followed by fully connected layers and a softmax or sigmoid for classification."}]
187:["$","h3",null,{"className":"flex scroll-m-28 flex-row items-center gap-2","id":"2-object-detection","children":[["$","a",null,{"data-card":"","href":"#2-object-detection","className":"peer","children":"2. Object Detection"}],["$","svg",null,{"ref":"$undefined","xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide size-3.5 shrink-0 text-fd-muted-foreground opacity-0 transition-opacity peer-hover:opacity-100","aria-label":"Link to section","children":[[["$","path","1cjeqo",{"d":"M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"}],["$","path","19qd67",{"d":"M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"}]],"$undefined"]}]]}]
188:["$","p",null,{"children":"Object detection builds on classification by not only identifying what is in an image but also where. Instead of predicting just a class label, the network must output:"}]
189:["$","ul",null,{"children":["\n",["$","li",null,{"children":"The object class"}],"\n",["$","li",null,{"children":"A bounding box around the object"}],"\n",["$","li",null,{"children":"Potentially multiple such predictions per image"}],"\n"]}]
18a:["$","p",null,{"children":"This increases complexity significantly, because:"}]
18b:["$","ul",null,{"children":["\n",["$","li",null,{"children":"Objects can appear anywhere in the image"}],"\n",["$","li",null,{"children":"They can vary in size and shape"}],"\n",["$","li",null,{"children":"The number of objects is not fixed"}],"\n"]}]
18c:["$","p",null,{"children":"A naive approach would involve placing thousands of boxes of different sizes at different locations and classifying each independently, but this is computationally infeasible."}]
18d:["$","h3",null,{"className":"flex scroll-m-28 flex-row items-center gap-2","id":"3-region-based-cnns-r-cnns","children":[["$","a",null,{"data-card":"","href":"#3-region-based-cnns-r-cnns","className":"peer","children":"3. Region-Based CNNs (R-CNNs)"}],["$","svg",null,{"ref":"$undefined","xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide size-3.5 shrink-0 text-fd-muted-foreground opacity-0 transition-opacity peer-hover:opacity-100","aria-label":"Link to section","children":[[["$","path","1cjeqo",{"d":"M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"}],["$","path","19qd67",{"d":"M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"}]],"$undefined"]}]]}]
18e:["$","p",null,{"children":"To address the inefficiency of naive detection, region-based CNNs were proposed. These models integrate regional proposal into the architecture itself. The Region Proposal Network (RPN) learns to identify parts of the image that are likely to contain objects. These regions are then passed through a shared feature extractor and classifier. This tight integration means the entire pipeline can be trained end-to-end using shared learned features. It is faster and more accurate than separate proposal and classification models."}]
18f:["$","h3",null,{"className":"flex scroll-m-28 flex-row items-center gap-2","id":"4-semantic-segmentation","children":[["$","a",null,{"data-card":"","href":"#4-semantic-segmentation","className":"peer","children":"4. Semantic Segmentation"}],["$","svg",null,{"ref":"$undefined","xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide size-3.5 shrink-0 text-fd-muted-foreground opacity-0 transition-opacity peer-hover:opacity-100","aria-label":"Link to section","children":[[["$","path","1cjeqo",{"d":"M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"}],["$","path","19qd67",{"d":"M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"}]],"$undefined"]}]]}]
190:["$","p",null,{"children":"Going beyond object detection, segmentation requires a per-pixel classification. For each pixel in the input image, the model outputs a class label (e.g., road, sky, person). Unlike classification, where we reduce the spatial dimensions, segmentation requires maintaining spatial resolution. This is often done by:"}]
191:["$","ul",null,{"children":["\n",["$","li",null,{"children":"Using convolutions and pooling to extract features (downsampling)"}],"\n",["$","li",null,{"children":"Then using upsampling or transposed convolutions to bring the output back to the input resolution"}],"\n"]}]
192:["$","p",null,{"children":"The output is an image-sized tensor where each pixel has a predicted class."}]
193:["$","h3",null,{"className":"flex scroll-m-28 flex-row items-center gap-2","id":"5-control-models-for-autonomous-navigation","children":[["$","a",null,{"data-card":"","href":"#5-control-models-for-autonomous-navigation","className":"peer","children":"5. Control Models for Autonomous Navigation"}],["$","svg",null,{"ref":"$undefined","xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide size-3.5 shrink-0 text-fd-muted-foreground opacity-0 transition-opacity peer-hover:opacity-100","aria-label":"Link to section","children":[[["$","path","1cjeqo",{"d":"M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"}],["$","path","19qd67",{"d":"M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"}]],"$undefined"]}]]}]
194:["$","p",null,{"children":"CNNs can also be used in control tasks, such as autonomous driving. In this setup, inputs might include:"}]
195:["$","ul",null,{"children":["\n",["$","li",null,{"children":"Camera images (first-person perspective)"}],"\n",["$","li",null,{"children":"Top-down or map-view representations"}],"\n"]}]
196:["$","p",null,{"children":["The network outputs are not discrete classes but continuous control signals, such as steering angles. Rather than classifying into fixed buckets, the model learns a distribution over continuous outputs effectively turning the classification head into a regression or probabilistic model.",["$","br",null,{}],"\n","These models can learn directly from driving data, inferring high-level representations that allow the system to drive in unseen environments. Unlike traditional autonomous driving stacks that require prior human-mapped routes, these models generalize to new cities using just visual input and map guidance."]}]
